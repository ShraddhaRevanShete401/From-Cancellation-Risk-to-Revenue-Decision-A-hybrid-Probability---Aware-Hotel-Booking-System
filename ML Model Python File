    "# ================================================================\n",
    "# STEP 13 — IMPLEMENT OVERBOOKING POLICIES\n",
    "# ================================================================\n",
    "# Purpose:\n",
    "#   Compare competing booking-acceptance policies on the untouched\n",
    "#   TEST period.\n",
    "#\n",
    "# Policies:\n",
    "#   1. No Overbooking\n",
    "#   2. Naive Historical Cancellation Rate\n",
    "#   3. Expected Shows\n",
    "#   4. Raw Probability Newsvendor\n",
    "#   5. Calibrated Probability Newsvendor\n",
    "#   6. Oracle (upper bound; NOT deployable)\n",
    "#\n",
    "# Initial scenario:\n",
    "#   Capacity = BASE capacity scenario\n",
    "#   Walk cost = 2x ADR\n",
    "#\n",
    "# Booking order:\n",
    "#   estimated_booking_date (earliest booking first)\n",
    "#\n",
    "# Important:\n",
    "#   Zero-night bookings are excluded because they do not consume\n",
    "#   room inventory.\n",
    "# ================================================================\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"STEP 13 — OVERBOOKING POLICY ENGINE\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 1. PREPARE TEST BOOKING STREAM\n",
    "# ------------------------------------------------\n",
    "policy_df = overbooking_test.copy()\n",
    "\n",
    "# Zero-night bookings do not consume room inventory.\n",
    "policy_df = policy_df[\n",
    "    policy_df[\"total_nights\"] > 0\n",
    "].copy()\n",
    "\n",
    "# Ensure booking dates are datetime\n",
    "policy_df[\"estimated_booking_date\"] = pd.to_datetime(\n",
    "    policy_df[\"estimated_booking_date\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "policy_df[\"arrival_date_full\"] = pd.to_datetime(\n",
    "    policy_df[\"arrival_date_full\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "# Remove rows where booking order cannot be established\n",
    "policy_df = policy_df[\n",
    "    policy_df[\"estimated_booking_date\"].notna()\n",
    "].copy()\n",
    "\n",
    "# Sort chronologically by booking date.\n",
    "# Booking_ID is used as a deterministic tie-breaker.\n",
    "policy_df = policy_df.sort_values(\n",
    "    [\"arrival_date_full\", \"estimated_booking_date\", \"Booking_ID\"]\n",
    ").reset_index(drop=True)\n",
    "\n",
    "print(\"\\nTest bookings available for simulation:\",\n",
    "      len(policy_df))\n",
    "\n",
    "print(\n",
    "    \"Test arrival dates:\",\n",
    "    policy_df[\"arrival_date_full\"].nunique()\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 2. BASE ECONOMIC PARAMETERS\n",
    "# ------------------------------------------------\n",
    "base_capacity = capacity_scenarios[\n",
    "    \"Base (50th percentile)\"\n",
    "]\n",
    "\n",
    "revenue_per_show = training_adr\n",
    "\n",
    "walk_cost = walk_cost_scenarios[\n",
    "    \"2x ADR\"\n",
    "]\n",
    "\n",
    "# Historical cancellation rate from TRAINING data only\n",
    "training_cancel_rate = train_df[\"target_cancelled\"].mean()\n",
    "\n",
    "# Corresponding historical show probability\n",
    "training_show_probability = 1 - training_cancel_rate\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"BASE SCENARIO\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(f\"Capacity: {base_capacity}\")\n",
    "print(f\"Revenue per show: {revenue_per_show:.2f}\")\n",
    "print(f\"Walk cost: {walk_cost:.2f}\")\n",
    "print(f\"Training cancellation rate: {training_cancel_rate:.4f}\")\n",
    "print(f\"Training show probability: {training_show_probability:.4f}\")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 3. POLICY DECISION HELPERS\n",
    "# ------------------------------------------------\n",
    "def expected_profit_from_probabilities(\n",
    "    probabilities,\n",
    "    capacity,\n",
    "    revenue,\n",
    "    walk_cost\n",
    "):\n",
    "    \"\"\"\n",
    "    Wrapper around the exact Poisson-binomial engine.\n",
    "    \"\"\"\n",
    "\n",
    "    return calculate_expected_profit(\n",
    "        probabilities=probabilities,\n",
    "        capacity=capacity,\n",
    "        revenue_per_show=revenue,\n",
    "        walk_cost_per_guest=walk_cost\n",
    "    )\n",
    "\n",
    "\n",
    "def optimal_booking_limit(\n",
    "    probabilities,\n",
    "    capacity,\n",
    "    revenue,\n",
    "    walk_cost\n",
    "):\n",
    "    \"\"\"\n",
    "    Find the booking limit that maximizes exact expected profit.\n",
    "\n",
    "    The candidate set consists of progressively accepting bookings\n",
    "    in chronological booking order.\n",
    "\n",
    "    Returns:\n",
    "        best_number_accepted\n",
    "        best_expected_profit\n",
    "        corresponding metrics\n",
    "    \"\"\"\n",
    "\n",
    "    probabilities = np.asarray(\n",
    "        probabilities,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    probabilities = np.clip(\n",
    "        probabilities,\n",
    "        0.0,\n",
    "        1.0\n",
    "    )\n",
    "\n",
    "    # At least the first booking can be considered.\n",
    "    if len(probabilities) == 0:\n",
    "        return 0, 0.0, calculate_expected_profit(\n",
    "            [],\n",
    "            capacity,\n",
    "            revenue,\n",
    "            walk_cost\n",
    "        )\n",
    "\n",
    "    best_n = 0\n",
    "    best_profit = 0.0\n",
    "    best_result = calculate_expected_profit(\n",
    "        [],\n",
    "        capacity,\n",
    "        revenue,\n",
    "        walk_cost\n",
    "    )\n",
    "\n",
    "    # Evaluate each possible booking limit.\n",
    "    #\n",
    "    # This is exact but can be computationally expensive for\n",
    "    # very large daily demand. The test period has manageable\n",
    "    # daily volumes.\n",
    "    for n in range(1, len(probabilities) + 1):\n",
    "\n",
    "        result = calculate_expected_profit(\n",
    "            probabilities[:n],\n",
    "            capacity,\n",
    "            revenue,\n",
    "            walk_cost\n",
    "        )\n",
    "\n",
    "        if result[\"expected_profit\"] > best_profit:\n",
    "\n",
    "            best_profit = result[\"expected_profit\"]\n",
    "            best_n = n\n",
    "            best_result = result\n",
    "\n",
    "    return best_n, best_profit, best_result\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 4. SIMULATE ONE POLICY ON ONE ARRIVAL DAY\n",
    "# ------------------------------------------------\n",
    "def simulate_day(\n",
    "    day_df,\n",
    "    policy_name,\n",
    "    capacity,\n",
    "    revenue,\n",
    "    walk_cost,\n",
    "    naive_show_probability\n",
    "):\n",
    "    \"\"\"\n",
    "    Simulate one arrival day.\n",
    "\n",
    "    Booking acceptance follows chronological booking order.\n",
    "\n",
    "    The returned metrics distinguish:\n",
    "        accepted bookings\n",
    "        actual shows\n",
    "        actual walks\n",
    "        actual empty rooms\n",
    "        actual revenue\n",
    "        actual walk cost\n",
    "        actual realized profit\n",
    "\n",
    "    Expected metrics are also retained where probability-based\n",
    "    decisions are involved.\n",
    "    \"\"\"\n",
    "\n",
    "    day_df = day_df.sort_values(\n",
    "        [\"estimated_booking_date\", \"Booking_ID\"]\n",
    "    ).copy()\n",
    "\n",
    "    n_demand = len(day_df)\n",
    "\n",
    "    # ------------------------------------------------\n",
    "    # SELECT POLICY PROBABILITIES\n",
    "    # ------------------------------------------------\n",
    "    if policy_name == \"Naive Historical\":\n",
    "\n",
    "        probability_column = None\n",
    "\n",
    "        probabilities = np.repeat(\n",
    "            naive_show_probability,\n",
    "            n_demand\n",
    "        )\n",
    "\n",
    "    elif policy_name == \"Raw Newsvendor\":\n",
    "\n",
    "        probability_column = \"raw_show_prob\"\n",
    "\n",
    "        probabilities = day_df[\n",
    "            probability_column\n",
    "        ].to_numpy()\n",
    "\n",
    "    elif policy_name == \"Calibrated Newsvendor\":\n",
    "\n",
    "        probability_column = \"calibrated_show_prob\"\n",
    "\n",
    "        probabilities = day_df[\n",
    "            probability_column\n",
    "        ].to_numpy()\n",
    "\n",
    "    elif policy_name == \"Expected Shows\":\n",
    "\n",
    "        probability_column = \"calibrated_show_prob\"\n",
    "\n",
    "        probabilities = day_df[\n",
    "            probability_column\n",
    "        ].to_numpy()\n",
    "\n",
    "    elif policy_name == \"No Overbooking\":\n",
    "\n",
    "        probability_column = None\n",
    "\n",
    "        # No-overbooking accepts at most capacity bookings.\n",
    "        accepted_n = min(\n",
    "            capacity,\n",
    "            n_demand\n",
    "        )\n",
    "\n",
    "        accepted_indices = np.arange(\n",
    "            accepted_n\n",
    "        )\n",
    "\n",
    "        probabilities = np.ones(\n",
    "            accepted_n\n",
    "        )\n",
    "\n",
    "    elif policy_name == \"Oracle\":\n",
    "\n",
    "        probability_column = None\n",
    "\n",
    "        # Oracle knows actual outcomes and therefore accepts\n",
    "        # bookings that actually show, subject to capacity.\n",
    "        actual_show_indices = np.where(\n",
    "            day_df[\"actual_show\"].to_numpy() == 1\n",
    "        )[0]\n",
    "\n",
    "        accepted_indices = actual_show_indices[\n",
    "            :capacity\n",
    "        ]\n",
    "\n",
    "        accepted_n = len(\n",
    "            accepted_indices\n",
    "        )\n",
    "\n",
    "        probabilities = np.ones(\n",
    "            accepted_n\n",
    "        )\n",
    "\n",
    "    else:\n",
    "        raise ValueError(\n",
    "            f\"Unknown policy: {policy_name}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # ------------------------------------------------\n",
    "    # DETERMINE ACCEPTED BOOKINGS\n",
    "    # ------------------------------------------------\n",
    "    if policy_name == \"No Overbooking\":\n",
    "\n",
    "        accepted_df = day_df.iloc[\n",
    "            accepted_indices\n",
    "        ].copy()\n",
    "\n",
    "    elif policy_name == \"Oracle\":\n",
    "\n",
    "        accepted_df = day_df.iloc[\n",
    "            accepted_indices\n",
    "        ].copy()\n",
    "\n",
    "    elif policy_name == \"Expected Shows\":\n",
    "\n",
    "        # Expected-show policy:\n",
    "        # accept bookings sequentially while cumulative expected\n",
    "        # show-ups remain within capacity.\n",
    "        cumulative_expected_shows = np.cumsum(\n",
    "            probabilities\n",
    "        )\n",
    "\n",
    "        valid_indices = np.where(\n",
    "            cumulative_expected_shows <= capacity\n",
    "        )[0]\n",
    "\n",
    "        if len(valid_indices) == 0:\n",
    "            accepted_n = 0\n",
    "        else:\n",
    "            accepted_n = valid_indices[-1] + 1\n",
    "\n",
    "        accepted_df = day_df.iloc[\n",
    "            :accepted_n\n",
    "        ].copy()\n",
    "\n",
    "    else:\n",
    "\n",
    "        # Newsvendor policies:\n",
    "        # choose the booking limit that maximizes exact\n",
    "        # expected profit.\n",
    "        accepted_n, _, _ = optimal_booking_limit(\n",
    "            probabilities=probabilities,\n",
    "            capacity=capacity,\n",
    "            revenue=revenue,\n",
    "            walk_cost=walk_cost\n",
    "        )\n",
    "\n",
    "        accepted_df = day_df.iloc[\n",
    "            :accepted_n\n",
    "        ].copy()\n",
    "\n",
    "\n",
    "    # ------------------------------------------------\n",
    "    # REALIZED OUTCOMES\n",
    "    # ------------------------------------------------\n",
    "    accepted_n = len(accepted_df)\n",
    "\n",
    "    if accepted_n > 0:\n",
    "\n",
    "        actual_shows = int(\n",
    "            accepted_df[\"actual_show\"].sum()\n",
    "        )\n",
    "\n",
    "    else:\n",
    "\n",
    "        actual_shows = 0\n",
    "\n",
    "\n",
    "    actual_walks = max(\n",
    "        0,\n",
    "        actual_shows - capacity\n",
    "    )\n",
    "\n",
    "    actual_occupied_rooms = min(\n",
    "        actual_shows,\n",
    "        capacity\n",
    "    )\n",
    "\n",
    "    actual_empty_rooms = max(\n",
    "        0,\n",
    "        capacity - actual_shows\n",
    "    )\n",
    "\n",
    "    actual_revenue = (\n",
    "        actual_occupied_rooms *\n",
    "        revenue\n",
    "    )\n",
    "\n",
    "    actual_walk_cost = (\n",
    "        actual_walks *\n",
    "        walk_cost\n",
    "    )\n",
    "\n",
    "    actual_profit = (\n",
    "        actual_revenue -\n",
    "        actual_walk_cost\n",
    "    )\n",
    "\n",
    "\n",
    "    # ------------------------------------------------\n",
    "    # EXPECTED OUTCOMES FOR ACCEPTED BOOKINGS\n",
    "    # ------------------------------------------------\n",
    "    if accepted_n > 0:\n",
    "\n",
    "        if policy_name == \"Naive Historical\":\n",
    "\n",
    "            accepted_probabilities = np.repeat(\n",
    "                naive_show_probability,\n",
    "                accepted_n\n",
    "            )\n",
    "\n",
    "        elif policy_name in [\n",
    "            \"Raw Newsvendor\",\n",
    "            \"Calibrated Newsvendor\",\n",
    "            \"Expected Shows\"\n",
    "        ]:\n",
    "\n",
    "            accepted_probabilities = (\n",
    "                day_df[\n",
    "                    (\n",
    "                        \"raw_show_prob\"\n",
    "                        if policy_name == \"Raw Newsvendor\"\n",
    "                        else \"calibrated_show_prob\"\n",
    "                    )\n",
    "                ]\n",
    "                .iloc[:accepted_n]\n",
    "                .to_numpy()\n",
    "            )\n",
    "\n",
    "        else:\n",
    "\n",
    "            # No-overbooking and oracle are evaluated\n",
    "            # primarily using realized outcomes.\n",
    "            accepted_probabilities = np.repeat(\n",
    "                1.0,\n",
    "                accepted_n\n",
    "            )\n",
    "\n",
    "        expected_metrics = calculate_expected_profit(\n",
    "            accepted_probabilities,\n",
    "            capacity,\n",
    "            revenue,\n",
    "            walk_cost\n",
    "        )\n",
    "\n",
    "    else:\n",
    "\n",
    "        expected_metrics = calculate_expected_profit(\n",
    "            [],\n",
    "            capacity,\n",
    "            revenue,\n",
    "            walk_cost\n",
    "        )\n",
    "\n",
    "\n",
    "    # ------------------------------------------------\n",
    "    # RETURN DAILY RESULT\n",
    "    # ------------------------------------------------\n",
    "    return {\n",
    "        \"arrival_date\": day_df[\n",
    "            \"arrival_date_full\"\n",
    "        ].iloc[0],\n",
    "\n",
    "        \"policy\": policy_name,\n",
    "\n",
    "        \"demand_bookings\": n_demand,\n",
    "\n",
    "        \"accepted_bookings\": accepted_n,\n",
    "\n",
    "        \"actual_shows\": actual_shows,\n",
    "\n",
    "        \"actual_walks\": actual_walks,\n",
    "\n",
    "        \"actual_empty_rooms\": actual_empty_rooms,\n",
    "\n",
    "        \"actual_revenue\": actual_revenue,\n",
    "\n",
    "        \"actual_walk_cost\": actual_walk_cost,\n",
    "\n",
    "        \"actual_profit\": actual_profit,\n",
    "\n",
    "        \"expected_shows\": expected_metrics[\n",
    "            \"expected_shows\"\n",
    "        ],\n",
    "\n",
    "        \"expected_walks\": expected_metrics[\n",
    "            \"expected_walks\"\n",
    "        ],\n",
    "\n",
    "        \"expected_empty_rooms\": expected_metrics[\n",
    "            \"expected_empty_rooms\"\n",
    "        ],\n",
    "\n",
    "        \"expected_profit\": expected_metrics[\n",
    "            \"expected_profit\"\n",
    "        ]\n",
    "    }\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 5. RUN ALL POLICIES\n",
    "# ------------------------------------------------\n",
    "policies = [\n",
    "    \"No Overbooking\",\n",
    "    \"Naive Historical\",\n",
    "    \"Expected Shows\",\n",
    "    \"Raw Newsvendor\",\n",
    "    \"Calibrated Newsvendor\",\n",
    "    \"Oracle\"\n",
    "]\n",
    "\n",
    "daily_policy_results = []\n",
    "\n",
    "for policy_name in policies:\n",
    "\n",
    "    for arrival_date, day_df in policy_df.groupby(\n",
    "        \"arrival_date_full\",\n",
    "        sort=True\n",
    "    ):\n",
    "\n",
    "        result = simulate_day(\n",
    "            day_df=day_df,\n",
    "            policy_name=policy_name,\n",
    "            capacity=base_capacity,\n",
    "            revenue=revenue_per_show,\n",
    "            walk_cost=walk_cost,\n",
    "            naive_show_probability=training_show_probability\n",
    "        )\n",
    "\n",
    "        daily_policy_results.append(result)\n",
    "\n",
    "\n",
    "policy_results_df = pd.DataFrame(\n",
    "    daily_policy_results\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 6. SUMMARIZE POLICY PERFORMANCE\n",
    "# ------------------------------------------------\n",
    "policy_summary = (\n",
    "    policy_results_df\n",
    "    .groupby(\"policy\")\n",
    "    .agg(\n",
    "        total_demand=(\"demand_bookings\", \"sum\"),\n",
    "        total_accepted=(\"accepted_bookings\", \"sum\"),\n",
    "        total_actual_shows=(\"actual_shows\", \"sum\"),\n",
    "        total_walks=(\"actual_walks\", \"sum\"),\n",
