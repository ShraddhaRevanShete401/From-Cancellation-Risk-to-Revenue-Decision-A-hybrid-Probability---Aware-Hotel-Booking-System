    "# ================================================================\n",
    "# STEP 19 — FINAL BUSINESS ANALYSIS\n",
    "# ================================================================\n",
    "#\n",
    "# Purpose:\n",
    "#   Convert the Step 18 policy simulation into the final\n",
    "#   business findings for the paper.\n",
    "#\n",
    "# Main questions:\n",
    "#   1. How much does the Hybrid improve over No Overbooking?\n",
    "#   2. How does Hybrid compare with Historical?\n",
    "#   3. How often does Hybrid win?\n",
    "#   4. What happens as walk cost increases?\n",
    "#   5. How close are deployable policies to the Oracle upper bound?\n",
    "# ================================================================\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"STEP 19 — FINAL BUSINESS ANALYSIS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 1. LOAD FINAL POLICY RESULTS\n",
    "# ------------------------------------------------\n",
    "\n",
    "results = pd.read_csv(\n",
    "    \"final_hybrid_overbooking_policy_results.csv\"\n",
    ")\n",
    "\n",
    "winners = pd.read_csv(\n",
    "    \"final_hybrid_policy_scenario_winners.csv\"\n",
    ")\n",
    "\n",
    "win_counts = pd.read_csv(\n",
    "    \"final_hybrid_policy_win_counts.csv\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nPolicy-result rows:\",\n",
    "    len(results)\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Scenario rows:\",\n",
    "    len(winners)\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 2. DEFINE DEPLOYABLE POLICIES\n",
    "# ------------------------------------------------\n",
    "\n",
    "deployable_policies = [\n",
    "    \"No Overbooking\",\n",
    "    \"Expected Shows\",\n",
    "    \"Historical Newsvendor\",\n",
    "    \"Raw ML Newsvendor\",\n",
    "    \"Calibrated ML Newsvendor\",\n",
    "    \"Frozen Hybrid Newsvendor\"\n",
    "]\n",
    "\n",
    "deployable = results[\n",
    "    results[\"policy\"].isin(\n",
    "        deployable_policies\n",
    "    )\n",
    "].copy()\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 3. HYBRID VS NO-OVERBOOKING\n",
    "# ------------------------------------------------\n",
    "\n",
    "hybrid = results[\n",
    "    results[\"policy\"] ==\n",
    "    \"Frozen Hybrid Newsvendor\"\n",
    "].copy()\n",
    "\n",
    "hybrid_no_overbooking = (\n",
    "    hybrid[\n",
    "        [\n",
    "            \"capacity\",\n",
    "            \"walk_cost\",\n",
    "            \"profit\",\n",
    "            \"profit_uplift_vs_no_overbooking_pct\"\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"HYBRID VS NO-OVERBOOKING\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    hybrid_no_overbooking\n",
    "    .round(2)\n",
    "    .to_string(index=False)\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 4. HYBRID VS HISTORICAL\n",
    "# ------------------------------------------------\n",
    "\n",
    "historical = results[\n",
    "    results[\"policy\"] ==\n",
    "    \"Historical Newsvendor\"\n",
    "].copy()\n",
    "\n",
    "comparison = hybrid[\n",
    "    [\n",
    "        \"capacity\",\n",
    "        \"walk_cost\",\n",
    "        \"profit\",\n",
    "        \"walks\",\n",
    "        \"empty_rooms\"\n",
    "    ]\n",
    "].merge(\n",
    "    historical[\n",
    "        [\n",
    "            \"capacity\",\n",
    "            \"walk_cost\",\n",
    "            \"profit\",\n",
    "            \"walks\",\n",
    "            \"empty_rooms\"\n",
    "        ]\n",
    "    ],\n",
    "    on=[\n",
    "        \"capacity\",\n",
    "        \"walk_cost\"\n",
    "    ],\n",
    "    suffixes=(\n",
    "        \"_hybrid\",\n",
    "        \"_historical\"\n",
    "    )\n",
    ")\n",
    "\n",
    "comparison[\"hybrid_profit_advantage\"] = (\n",
    "    comparison[\"profit_hybrid\"] -\n",
    "    comparison[\"profit_historical\"]\n",
    ")\n",
    "\n",
    "comparison[\"hybrid_profit_advantage_pct\"] = (\n",
    "    comparison[\"hybrid_profit_advantage\"] /\n",
    "    comparison[\"profit_historical\"] *\n",
    "    100\n",
    ")\n",
    "\n",
    "comparison[\"hybrid_walk_difference\"] = (\n",
    "    comparison[\"walks_hybrid\"] -\n",
    "    comparison[\"walks_historical\"]\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"HYBRID VS HISTORICAL NEWSVENDOR\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    comparison\n",
    "    .round(2)\n",
    "    .to_string(index=False)\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 5. SCENARIO-WISE BEST DEPLOYABLE POLICY\n",
    "# ------------------------------------------------\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"SCENARIO-WISE BEST DEPLOYABLE POLICY\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "scenario_summary = (\n",
    "    deployable\n",
    "    .sort_values(\n",
    "        [\n",
    "            \"capacity\",\n",
    "            \"walk_cost\",\n",
    "            \"profit\"\n",
    "        ],\n",
    "        ascending=[\n",
    "            True,\n",
    "            True,\n",
    "            False\n",
    "        ]\n",
    "    )\n",
    "    .groupby(\n",
    "        [\n",
    "            \"capacity\",\n",
    "            \"walk_cost\"\n",
    "        ],\n",
    "        as_index=False\n",
    "    )\n",
    "    .first()\n",
    ")\n",
    "\n",
    "print(\n",
    "    scenario_summary[\n",
    "        [\n",
    "            \"capacity\",\n",
    "            \"walk_cost\",\n",
    "            \"policy\",\n",
    "            \"profit\",\n",
    "            \"walks\",\n",
    "            \"empty_rooms\",\n",
    "            \"profit_uplift_vs_no_overbooking_pct\"\n",
    "        ]\n",
    "    ]\n",
    "    .round(2)\n",
    "    .to_string(index=False)\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 6. AVERAGE PROFIT ACROSS ALL SCENARIOS\n",
    "# ------------------------------------------------\n",
    "\n",
    "average_policy_performance = (\n",
    "    deployable\n",
    "    .groupby(\"policy\")\n",
    "    .agg(\n",
    "        mean_profit=(\n",
    "            \"profit\",\n",
    "            \"mean\"\n",
    "        ),\n",
    "        mean_profit_per_day=(\n",
    "            \"profit_per_day\",\n",
    "            \"mean\"\n",
    "        ),\n",
    "        mean_walks=(\n",
    "            \"walks\",\n",
    "            \"mean\"\n",
    "        ),\n",
    "        mean_empty_rooms=(\n",
    "            \"empty_rooms\",\n",
    "            \"mean\"\n",
    "        ),\n",
    "        mean_uplift_vs_no_overbooking=(\n",
    "            \"profit_uplift_vs_no_overbooking_pct\",\n",
    "            \"mean\"\n",
    "        )\n",
    "    )\n",
    "    .reset_index()\n",
    "    .sort_values(\n",
    "        \"mean_profit\",\n",
    "        ascending=False\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"AVERAGE PERFORMANCE ACROSS 9 SCENARIOS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    average_policy_performance\n",
    "    .round(2)\n",
    "    .to_string(index=False)\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 7. POLICY WIN COUNTS\n",
    "# ------------------------------------------------\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"POLICY WIN COUNTS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    win_counts\n",
    "    .to_string(index=False)\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 8. HYBRID WIN RATE\n",
    "# ------------------------------------------------\n",
    "\n",
    "hybrid_wins = (\n",
    "    winners[\"winning_policy\"] ==\n",
    "    \"Frozen Hybrid Newsvendor\"\n",
    ").sum()\n",
    "\n",
    "total_scenarios = len(winners)\n",
    "\n",
    "hybrid_win_rate = (\n",
    "    hybrid_wins /\n",
    "    total_scenarios *\n",
    "    100\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"\\nHybrid scenario win rate: \"\n",
    "    f\"{hybrid_win_rate:.1f}% \"\n",
    "    f\"({hybrid_wins}/{total_scenarios})\"\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 9. PROFIT SENSITIVITY TO WALK COST\n",
    "# ------------------------------------------------\n",
    "\n",
    "hybrid_walk_sensitivity = (\n",
    "    hybrid\n",
    "    .groupby(\"walk_cost\")\n",
    "    .agg(\n",
    "        mean_profit=(\n",
    "            \"profit\",\n",
    "            \"mean\"\n",
    "        ),\n",
    "        mean_walks=(\n",
    "            \"walks\",\n",
    "            \"mean\"\n",
    "        ),\n",
    "        mean_empty_rooms=(\n",
    "            \"empty_rooms\",\n",
    "            \"mean\"\n",
    "        ),\n",
    "        mean_uplift=(\n",
    "            \"profit_uplift_vs_no_overbooking_pct\",\n",
    "            \"mean\"\n",
    "        )\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"HYBRID SENSITIVITY TO WALK COST\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    hybrid_walk_sensitivity\n",
    "    .round(2)\n",
    "    .to_string(index=False)\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 10. PROFIT SENSITIVITY TO CAPACITY\n",
    "# ------------------------------------------------\n",
    "\n",
    "hybrid_capacity_sensitivity = (\n",
    "    hybrid\n",
    "    .groupby(\"capacity\")\n",
    "    .agg(\n",
    "        mean_profit=(\n",
    "            \"profit\",\n",
    "            \"mean\"\n",
    "        ),\n",
    "        mean_walks=(\n",
    "            \"walks\",\n",
    "            \"mean\"\n",
    "        ),\n",
    "        mean_empty_rooms=(\n",
    "            \"empty_rooms\",\n",
    "            \"mean\"\n",
    "        ),\n",
    "        mean_uplift=(\n",
    "            \"profit_uplift_vs_no_overbooking_pct\",\n",
    "            \"mean\"\n",
    "        )\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"HYBRID SENSITIVITY TO CAPACITY\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    hybrid_capacity_sensitivity\n",
    "    .round(2)\n",
    "    .to_string(index=False)\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 11. COMPARE DEPLOYABLE POLICIES WITH ORACLE\n",
    "# ------------------------------------------------\n",
    "\n",
    "oracle = results[\n",
    "    results[\"policy\"] ==\n",
    "    \"Oracle\"\n",
    "][\n",
    "    [\n",
    "        \"capacity\",\n",
    "        \"walk_cost\",\n",
    "        \"profit\"\n",
    "    ]\n",
    "].rename(\n",
    "    columns={\n",
    "        \"profit\":\n",
    "            \"oracle_profit\"\n",
    "    }\n",
    ")\n",
    "\n",
    "deployable_oracle = (\n",
    "    deployable\n",
    "    .merge(\n",
    "        oracle,\n",
    "        on=[\n",
    "            \"capacity\",\n",
    "            \"walk_cost\"\n",
    "        ],\n",
    "        how=\"left\"\n",
    "    )\n",
    ")\n",
    "\n",
    "deployable_oracle[\n",
    "    \"oracle_gap\"\n",
    "] = (\n",
    "    deployable_oracle[\n",
    "        \"oracle_profit\"\n",
    "    ] -\n",
    "    deployable_oracle[\n",
    "        \"profit\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "deployable_oracle[\n",
    "    \"oracle_capture_pct\"\n",
    "] = (\n",
    "    deployable_oracle[\n",
    "        \"profit\"\n",
    "    ] /\n",
    "    deployable_oracle[\n",
    "        \"oracle_profit\"\n",
    "    ] *\n",
    "    100\n",
    ")\n",
    "\n",
    "oracle_capture_summary = (\n",
    "    deployable_oracle\n",
    "    .groupby(\"policy\")\n",
    "    .agg(\n",
    "        mean_oracle_capture_pct=(\n",
    "            \"oracle_capture_pct\",\n",
    "            \"mean\"\n",
    "        ),\n",
    "        mean_oracle_gap=(\n",
    "            \"oracle_gap\",\n",
    "            \"mean\"\n",
    "        )\n",
    "    )\n",
    "    .reset_index()\n",
    "    .sort_values(\n",
    "        \"mean_oracle_capture_pct\",\n",
    "        ascending=False\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"ORACLE PROFIT CAPTURE\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    oracle_capture_summary\n",
    "    .round(2)\n",
    "    .to_string(index=False)\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 12. IDENTIFY STRONGEST HYBRID ADVANTAGE\n",
    "# ------------------------------------------------\n",
    "\n",
    "strongest_hybrid_advantage = (\n",
    "    comparison.loc[\n",
    "        comparison[\n",
    "            \"hybrid_profit_advantage\"\n",
    "        ].idxmax()\n",
    "    ]\n",
    ")\n",
    "\n",
    "largest_hybrid_loss = (\n",
    "    comparison.loc[\n",
    "        comparison[\n",
    "            \"hybrid_profit_advantage\"\n",
    "        ].idxmin()\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"EXTREME HYBRID COMPARISONS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    \"\\nStrongest Hybrid advantage vs Historical:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    strongest_hybrid_advantage[\n",
    "        [\n",
    "            \"capacity\",\n",
    "            \"walk_cost\",\n",
    "            \"profit_hybrid\",\n",
    "            \"profit_historical\",\n",
    "            \"hybrid_profit_advantage\",\n",
    "            \"hybrid_profit_advantage_pct\"\n",
    "        ]\n",
    "    ]\n",
    "    .round(2)\n",
    "    .to_string()\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nLargest Hybrid disadvantage vs Historical:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    largest_hybrid_loss[\n",
    "        [\n",
    "            \"capacity\",\n",
    "            \"walk_cost\",\n",
    "            \"profit_hybrid\",\n",
    "            \"profit_historical\",\n",
    "            \"hybrid_profit_advantage\",\n",
    "            \"hybrid_profit_advantage_pct\"\n",
    "        ]\n",
    "    ]\n",
    "    .round(2)\n",
    "    .to_string()\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 13. FINAL HEADLINE METRICS\n",
    "# ------------------------------------------------\n",
    "\n",
    "mean_hybrid_profit = (\n",
    "    hybrid[\"profit\"].mean()\n",
    ")\n",
    "\n",
    "mean_historical_profit = (\n",
    "    historical[\"profit\"].mean()\n",
    ")\n",
    "\n",
    "mean_no_overbooking_profit = (\n",
    "    results[\n",
    "        results[\"policy\"] ==\n",
    "        \"No Overbooking\"\n",
    "    ][\"profit\"].mean()\n",
    ")\n",
    "\n",
    "mean_hybrid_uplift = (\n",
    "    hybrid[\n",
    "        \"profit_uplift_vs_no_overbooking_pct\"\n",
    "    ].mean()\n",
    ")\n",
    "\n",
    "mean_historical_uplift = (\n",
    "    historical[\n",
    "        \"profit_uplift_vs_no_overbooking_pct\"\n",
    "    ].mean()\n",
    ")\n",
    "\n",
    "hybrid_vs_historical_average_pct = (\n",
    "    (\n",
    "        mean_hybrid_profit -\n",
    "        mean_historical_profit\n",
    "    )\n",
    "    /\n",
    "    mean_historical_profit\n",
    "    * 100\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"FINAL HEADLINE BUSINESS METRICS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    f\"Mean Hybrid profit across scenarios: \"\n",
    "    f\"{mean_hybrid_profit:,.2f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Mean Historical profit across scenarios: \"\n",
    "    f\"{mean_historical_profit:,.2f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Mean No-Overbooking profit across scenarios: \"\n",
    "    f\"{mean_no_overbooking_profit:,.2f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Hybrid mean uplift vs No Overbooking: \"\n",
    "    f\"{mean_hybrid_uplift:.2f}%\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Historical mean uplift vs No Overbooking: \"\n",
    "    f\"{mean_historical_uplift:.2f}%\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Hybrid average profit advantage vs Historical: \"\n",
    "    f\"{hybrid_vs_historical_average_pct:.2f}%\"\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 14. SAVE FINAL BUSINESS TABLES\n",
    "# ------------------------------------------------\n",
    "\n",
    "hybrid_no_overbooking.to_csv(\n",
    "    \"final_hybrid_vs_no_overbooking.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "comparison.to_csv(\n",
    "    \"final_hybrid_vs_historical.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "scenario_summary.to_csv(\n",
    "    \"final_scenario_best_policy.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "average_policy_performance.to_csv(\n",
    "    \"final_average_policy_performance.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "hybrid_walk_sensitivity.to_csv(\n",
    "    \"final_hybrid_walk_cost_sensitivity.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "hybrid_capacity_sensitivity.to_csv(\n",
    "    \"final_hybrid_capacity_sensitivity.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "oracle_capture_summary.to_csv(\n",
    "    \"final_oracle_profit_capture.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"FILES SAVED\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\"final_hybrid_vs_no_overbooking.csv\")\n",
    "print(\"final_hybrid_vs_historical.csv\")\n",
    "print(\"final_scenario_best_policy.csv\")\n",
    "print(\"final_average_policy_performance.csv\")\n",
    "print(\"final_hybrid_walk_cost_sensitivity.csv\")\n",
    "print(\"final_hybrid_capacity_sensitivity.csv\")\n",
    "print(\"final_oracle_profit_capture.csv\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"STEP 19 COMPLETE\")\n",
    "print(\"=\" * 70)"
   ]
