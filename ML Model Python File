   "source": [
    "# ============================================================\n",
    "# STEP 8: ISOTONIC PROBABILITY CALIBRATION\n",
    "# ============================================================\n",
    "# Goal:\n",
    "# Convert the Gradient Boosting model's raw probabilities\n",
    "# into better-calibrated cancellation probabilities.\n",
    "#\n",
    "# We use:\n",
    "#     Isotonic Regression\n",
    "#\n",
    "# IMPORTANT:\n",
    "# The CALIBRATION dataset is used ONLY for fitting the\n",
    "# calibration function.\n",
    "#\n",
    "# The TEST dataset remains completely untouched.\n",
    "# ============================================================\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "from sklearn.isotonic import IsotonicRegression\n",
    "\n",
    "from sklearn.metrics import (\n",
    "    brier_score_loss,\n",
    "    log_loss,\n",
    "    roc_auc_score,\n",
    "    average_precision_score\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 1. Retrieve the selected Gradient Boosting model\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "best_model = trained_models[\"Gradient Boosting\"]\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 2. Generate RAW probabilities on the calibration set\n",
    "# ------------------------------------------------------------\n",
    "# Probability represents:\n",
    "#\n",
    "#     P(Cancellation = 1)\n",
    "#\n",
    "# We have NOT calibrated these probabilities yet.\n",
    "\n",
    "calibration_raw_prob = best_model.predict_proba(\n",
    "    X_calibration\n",
    ")[:, 1]\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 3. Fit Isotonic Regression\n",
    "# ------------------------------------------------------------\n",
    "# Isotonic regression learns a monotonic mapping:\n",
    "#\n",
    "#     raw probability → calibrated probability\n",
    "#\n",
    "# It does not assume a particular functional form.\n",
    "\n",
    "isotonic_calibrator = IsotonicRegression(\n",
    "    y_min=0,\n",
    "    y_max=1,\n",
    "    out_of_bounds=\"clip\"\n",
    ")\n",
    "\n",
    "\n",
    "isotonic_calibrator.fit(\n",
    "    calibration_raw_prob,\n",
    "    y_calibration\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 4. Generate calibrated probabilities\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "calibration_calibrated_prob = (\n",
    "    isotonic_calibrator.predict(\n",
    "        calibration_raw_prob\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 5. Compare RAW vs CALIBRATED probabilities\n",
    "#    on the calibration dataset\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "raw_brier = brier_score_loss(\n",
    "    y_calibration,\n",
    "    calibration_raw_prob\n",
    ")\n",
    "\n",
    "calibrated_brier = brier_score_loss(\n",
    "    y_calibration,\n",
    "    calibration_calibrated_prob\n",
    ")\n",
    "\n",
    "\n",
    "raw_logloss = log_loss(\n",
    "    y_calibration,\n",
    "    calibration_raw_prob\n",
    ")\n",
    "\n",
    "calibrated_logloss = log_loss(\n",
    "    y_calibration,\n",
    "    calibration_calibrated_prob\n",
    ")\n",
    "\n",
    "\n",
    "raw_auc = roc_auc_score(\n",
    "    y_calibration,\n",
    "    calibration_raw_prob\n",
    ")\n",
    "\n",
    "calibrated_auc = roc_auc_score(\n",
    "    y_calibration,\n",
    "    calibration_calibrated_prob\n",
    ")\n",
    "\n",
    "\n",
    "raw_pr_auc = average_precision_score(\n",
    "    y_calibration,\n",
    "    calibration_raw_prob\n",
    ")\n",
    "\n",
    "calibrated_pr_auc = average_precision_score(\n",
    "    y_calibration,\n",
    "    calibration_calibrated_prob\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 6. Create comparison table\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "calibration_comparison = pd.DataFrame({\n",
    "\n",
    "    \"Model_Output\": [\n",
    "        \"Raw Gradient Boosting\",\n",
    "        \"Isotonic Calibrated\"\n",
    "    ],\n",
    "\n",
    "    \"ROC_AUC\": [\n",
    "        raw_auc,\n",
    "        calibrated_auc\n",
    "    ],\n",
    "\n",
    "    \"PR_AUC\": [\n",
    "        raw_pr_auc,\n",
    "        calibrated_pr_auc\n",
    "    ],\n",
    "\n",
    "    \"Brier\": [\n",
    "        raw_brier,\n",
    "        calibrated_brier\n",
    "    ],\n",
    "\n",
    "    \"Log_Loss\": [\n",
    "        raw_logloss,\n",
    "        calibrated_logloss\n",
    "    ]\n",
    "})\n",
    "\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"CALIBRATION DATASET: RAW VS ISOTONIC\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    calibration_comparison.to_string(\n",
    "        index=False,\n",
    "        float_format=lambda x: f\"{x:.4f}\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 7. Calculate improvement in Brier score\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "brier_improvement = (\n",
    "    (raw_brier - calibrated_brier)\n",
    "    / raw_brier\n",
    "    * 100\n",
    ")\n",
    "\n",
    "\n",
    "logloss_improvement = (\n",
    "    (raw_logloss - calibrated_logloss)\n",
    "    / raw_logloss\n",
    "    * 100\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"CALIBRATION IMPROVEMENT\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    f\"Brier improvement: {brier_improvement:.2f}%\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Log-loss improvement: {logloss_improvement:.2f}%\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 8. Convert cancellation probability to show probability\n",
    "# ------------------------------------------------------------\n",
    "# This is extremely important for the overbooking stage.\n",
    "#\n",
    "# If:\n",
    "#\n",
    "#     P(cancel) = 0.30\n",
    "#\n",
    "# then:\n",
    "#\n",
    "#     P(show) = 1 - 0.30 = 0.70\n",
    "#\n",
    "# We will use P(show) in the Poisson-binomial\n",
    "# overbooking calculation.\n",
    "\n",
    "calibration_raw_show_prob = (\n",
    "    1 - calibration_raw_prob\n",
    ")\n",
    "\n",
    "calibration_calibrated_show_prob = (\n",
    "    1 - calibration_calibrated_prob\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 9. Display probability ranges\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"PROBABILITY RANGES\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    \"Raw cancellation probability:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Minimum: {calibration_raw_prob.min():.4f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Maximum: {calibration_raw_prob.max():.4f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Mean:    {calibration_raw_prob.mean():.4f}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nCalibrated cancellation probability:\")\n",
    "\n",
    "print(\n",
    "    f\"Minimum: {calibration_calibrated_prob.min():.4f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Maximum: {calibration_calibrated_prob.max():.4f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Mean:    {calibration_calibrated_prob.mean():.4f}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 10. Save calibration results\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "calibration_probability_df = pd.DataFrame({\n",
    "\n",
    "    \"actual_cancelled\":\n",
    "        y_calibration.values,\n",
    "\n",
    "    \"raw_cancel_probability\":\n",
    "        calibration_raw_prob,\n",
    "\n",
    "    \"calibrated_cancel_probability\":\n",
    "        calibration_calibrated_prob,\n",
    "\n",
    "    \"raw_show_probability\":\n",
    "        calibration_raw_show_prob,\n",
    "\n",
    "    \"calibrated_show_probability\":\n",
    "        calibration_calibrated_show_prob\n",
    "})\n",
    "\n",
    "\n",
    "calibration_probability_df.to_csv(\n",
    "    \"calibration_probabilities.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "calibration_comparison.to_csv(\n",
    "    \"calibration_comparison.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"FILES SAVED\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\"calibration_probabilities.csv\")\n",
    "print(\"calibration_comparison.csv\")\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"STEP 8 COMPLETE\")\n",
    "print(\"=\" * 70)"
   ]
