    "# ============================================================\n",
    "# STEP 5: TIME-BASED TRAIN / VALIDATION / CALIBRATION / TEST SPLIT\n",
    "# ============================================================\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 1. Make a modeling copy\n",
    "# ------------------------------------------------------------\n",
    "model_df = df_clean.copy()\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 2. Remove temporary EDA grouping columns\n",
    "#    These were created only for analysis and should NOT\n",
    "#    accidentally become model predictors.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "eda_columns = [\n",
    "    \"lead_time_group\",\n",
    "    \"previous_cancel_group\",\n",
    "    \"stay_length_group\",\n",
    "    \"booking_value_group\"\n",
    "]\n",
    "\n",
    "model_df = model_df.drop(\n",
    "    columns=[col for col in eda_columns if col in model_df.columns],\n",
    "    errors=\"ignore\"\n",
    ")\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 3. Make sure arrival_date_full is a proper datetime\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "model_df[\"arrival_date_full\"] = pd.to_datetime(\n",
    "    model_df[\"arrival_date_full\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "# Remove rows where arrival date is still invalid\n",
    "model_df = model_df.dropna(\n",
    "    subset=[\"arrival_date_full\"]\n",
    ").copy()\n",
    "\n",
    "# Sort chronologically\n",
    "model_df = model_df.sort_values(\n",
    "    \"arrival_date_full\"\n",
    ").reset_index(drop=True)\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 4. Display the actual time range\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"DATASET TIME RANGE\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\"Minimum arrival date:\",\n",
    "      model_df[\"arrival_date_full\"].min().date())\n",
    "\n",
    "print(\"Maximum arrival date:\",\n",
    "      model_df[\"arrival_date_full\"].max().date())\n",
    "\n",
    "print(\"Total observations:\", len(model_df))\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 5. Create chronological split boundaries\n",
    "#\n",
    "# We use the chronological order of the data rather than\n",
    "# randomly splitting observations.\n",
    "#\n",
    "# 60% -> Training\n",
    "# 15% -> Validation\n",
    "# 15% -> Calibration\n",
    "# 10% -> Final Test\n",
    "#\n",
    "# IMPORTANT:\n",
    "# The split is based on sorted observations, not random sampling.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "n = len(model_df)\n",
    "\n",
    "train_end = int(n * 0.60)\n",
    "validation_end = int(n * 0.75)\n",
    "calibration_end = int(n * 0.90)\n",
    "\n",
    "train_df = model_df.iloc[:train_end].copy()\n",
    "\n",
    "validation_df = model_df.iloc[\n",
    "    train_end:validation_end\n",
    "].copy()\n",
    "\n",
    "calibration_df = model_df.iloc[\n",
    "    validation_end:calibration_end\n",
    "].copy()\n",
    "\n",
    "test_df = model_df.iloc[\n",
    "    calibration_end:\n",
    "].copy()\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 6. Display the split sizes\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"SPLIT SIZES\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "split_summary = pd.DataFrame({\n",
    "    \"Dataset\": [\n",
    "        \"Train\",\n",
    "        \"Validation\",\n",
    "        \"Calibration\",\n",
    "        \"Test\"\n",
    "    ],\n",
    "    \"Rows\": [\n",
    "        len(train_df),\n",
    "        len(validation_df),\n",
    "        len(calibration_df),\n",
    "        len(test_df)\n",
    "    ],\n",
    "    \"Percentage\": [\n",
    "        len(train_df) / n * 100,\n",
    "        len(validation_df) / n * 100,\n",
    "        len(calibration_df) / n * 100,\n",
    "        len(test_df) / n * 100\n",
    "    ],\n",
    "    \"Start_Date\": [\n",
    "        train_df[\"arrival_date_full\"].min(),\n",
    "        validation_df[\"arrival_date_full\"].min(),\n",
    "        calibration_df[\"arrival_date_full\"].min(),\n",
    "        test_df[\"arrival_date_full\"].min()\n",
    "    ],\n",
    "    \"End_Date\": [\n",
    "        train_df[\"arrival_date_full\"].max(),\n",
    "        validation_df[\"arrival_date_full\"].max(),\n",
    "        calibration_df[\"arrival_date_full\"].max(),\n",
    "        test_df[\"arrival_date_full\"].max()\n",
    "    ]\n",
    "})\n",
    "\n",
    "print(split_summary.to_string(index=False))\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 7. Check cancellation rate in each period\n",
    "#\n",
    "# This is important because the cancellation behaviour itself\n",
    "# may change over time.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "split_target_summary = pd.DataFrame({\n",
    "    \"Dataset\": [\n",
    "        \"Train\",\n",
    "        \"Validation\",\n",
    "        \"Calibration\",\n",
