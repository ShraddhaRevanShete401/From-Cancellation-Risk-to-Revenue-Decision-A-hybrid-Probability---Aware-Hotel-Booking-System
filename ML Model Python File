    "    log_loss\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 1. Generate RAW cancellation probabilities on TEST\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "test_raw_prob = best_model.predict_proba(\n",
    "    X_test\n",
    ")[:, 1]\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 2. Apply the already-fitted isotonic calibrator\n",
    "# ------------------------------------------------------------\n",
    "# IMPORTANT:\n",
    "# We DO NOT fit isotonic regression again.\n",
    "#\n",
    "# We use the calibrator learned from the calibration dataset.\n",
    "\n",
    "test_calibrated_prob = isotonic_calibrator.predict(\n",
    "    test_raw_prob\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 3. Define Expected Calibration Error (ECE)\n",
    "# ------------------------------------------------------------\n",
    "# ECE measures the difference between:\n",
    "#\n",
    "#   predicted probability\n",
    "#       vs.\n",
    "#   actual event frequency\n",
    "#\n",
    "# Lower ECE = better calibration.\n",
    "#\n",
    "# We use 10 probability bins.\n",
    "\n",
    "def calculate_ece(\n",
    "    y_true,\n",
    "    probabilities,\n",
    "    n_bins=10\n",
    "):\n",
    "\n",
    "    y_true = np.asarray(y_true)\n",
    "    probabilities = np.asarray(probabilities)\n",
    "\n",
    "    # Create equally spaced probability bins\n",
    "    bin_edges = np.linspace(\n",
    "        0,\n",
    "        1,\n",
    "        n_bins + 1\n",
    "    )\n",
    "\n",
    "    ece = 0.0\n",
    "\n",
    "    bin_results = []\n",
    "\n",
    "    for i in range(n_bins):\n",
    "\n",
    "        # Include the right boundary in the final bin\n",
    "        if i == n_bins - 1:\n",
    "\n",
    "            mask = (\n",
    "                (probabilities >= bin_edges[i]) &\n",
    "                (probabilities <= bin_edges[i + 1])\n",
    "            )\n",
    "\n",
    "        else:\n",
    "\n",
    "            mask = (\n",
    "                (probabilities >= bin_edges[i]) &\n",
    "                (probabilities < bin_edges[i + 1])\n",
    "            )\n",
    "\n",
    "        # Skip empty bins\n",
    "        if mask.sum() == 0:\n",
    "            continue\n",
    "\n",
    "        mean_predicted = probabilities[mask].mean()\n",
    "\n",
    "        observed_rate = y_true[mask].mean()\n",
    "\n",
    "        bin_size = mask.sum()\n",
    "\n",
    "        bin_weight = bin_size / len(y_true)\n",
    "\n",
    "        absolute_difference = abs(\n",
    "            mean_predicted - observed_rate\n",
    "        )\n",
    "\n",
    "        ece += (\n",
    "            bin_weight\n",
    "            * absolute_difference\n",
    "        )\n",
    "\n",
    "        bin_results.append({\n",
    "\n",
    "            \"bin\": i + 1,\n",
    "\n",
    "            \"bin_lower\": bin_edges[i],\n",
    "\n",
    "            \"bin_upper\": bin_edges[i + 1],\n",
    "\n",
    "            \"count\": bin_size,\n",
    "\n",
    "            \"mean_predicted\": mean_predicted,\n",
    "\n",
    "            \"observed_rate\": observed_rate,\n",
    "\n",
    "            \"absolute_error\": absolute_difference\n",
    "        })\n",
    "\n",
    "    return ece, pd.DataFrame(bin_results)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 4. Calculate TEST metrics for RAW probabilities\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "raw_test_auc = roc_auc_score(\n",
    "    y_test,\n",
    "    test_raw_prob\n",
    ")\n",
    "\n",
    "raw_test_pr_auc = average_precision_score(\n",
    "    y_test,\n",
    "    test_raw_prob\n",
    ")\n",
    "\n",
    "raw_test_brier = brier_score_loss(\n",
    "    y_test,\n",
    "    test_raw_prob\n",
    ")\n",
    "\n",
    "raw_test_logloss = log_loss(\n",
    "    y_test,\n",
    "    test_raw_prob\n",
    ")\n",
    "\n",
    "raw_test_ece, raw_bins = calculate_ece(\n",
    "    y_test,\n",
    "    test_raw_prob,\n",
    "    n_bins=10\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 5. Calculate TEST metrics for CALIBRATED probabilities\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "calibrated_test_auc = roc_auc_score(\n",
    "    y_test,\n",
    "    test_calibrated_prob\n",
    ")\n",
    "\n",
    "calibrated_test_pr_auc = average_precision_score(\n",
    "    y_test,\n",
    "    test_calibrated_prob\n",
    ")\n",
    "\n",
    "calibrated_test_brier = brier_score_loss(\n",
    "    y_test,\n",
    "    test_calibrated_prob\n",
    ")\n",
    "\n",
    "calibrated_test_logloss = log_loss(\n",
    "    y_test,\n",
    "    test_calibrated_prob\n",
    ")\n",
    "\n",
    "calibrated_test_ece, calibrated_bins = calculate_ece(\n",
    "    y_test,\n",
    "    test_calibrated_prob,\n",
    "    n_bins=10\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 6. Create final test comparison table\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "test_calibration_comparison = pd.DataFrame({\n",
    "\n",
    "    \"Model_Output\": [\n",
    "        \"Raw Gradient Boosting\",\n",
    "        \"Isotonic Calibrated\"\n",
    "    ],\n",
    "\n",
    "    \"ROC_AUC\": [\n",
    "        raw_test_auc,\n",
    "        calibrated_test_auc\n",
    "    ],\n",
    "\n",
    "    \"PR_AUC\": [\n",
    "        raw_test_pr_auc,\n",
    "        calibrated_test_pr_auc\n",
    "    ],\n",
    "\n",
    "    \"Brier\": [\n",
    "        raw_test_brier,\n",
    "        calibrated_test_brier\n",
    "    ],\n",
    "\n",
    "    \"Log_Loss\": [\n",
    "        raw_test_logloss,\n",
    "        calibrated_test_logloss\n",
    "    ],\n",
    "\n",
    "    \"ECE\": [\n",
    "        raw_test_ece,\n",
    "        calibrated_test_ece\n",
    "    ]\n",
    "})\n",
    "\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"FINAL TEST-SET CALIBRATION COMPARISON\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    test_calibration_comparison.to_string(\n",
    "        index=False,\n",
    "        float_format=lambda x: f\"{x:.4f}\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 7. Calculate percentage improvements\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "brier_test_improvement = (\n",
    "    (raw_test_brier - calibrated_test_brier)\n",
    "    / raw_test_brier\n",
    "    * 100\n",
    ")\n",
    "\n",
    "logloss_test_improvement = (\n",
    "    (raw_test_logloss - calibrated_test_logloss)\n",
    "    / raw_test_logloss\n",
    "    * 100\n",
    ")\n",
    "\n",
    "ece_test_improvement = (\n",
    "    (raw_test_ece - calibrated_test_ece)\n",
    "    / raw_test_ece\n",
    "    * 100\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"TEST-SET CALIBRATION IMPROVEMENT\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    f\"Brier improvement   : \"\n",
    "    f\"{brier_test_improvement:.2f}%\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Log-loss improvement: \"\n",
    "    f\"{logloss_test_improvement:.2f}%\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"ECE improvement     : \"\n",
    "    f\"{ece_test_improvement:.2f}%\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 8. Display reliability-bin information\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"RAW PROBABILITY RELIABILITY BINS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    raw_bins.to_string(\n",
    "        index=False,\n",
    "        float_format=lambda x: f\"{x:.4f}\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"CALIBRATED PROBABILITY RELIABILITY BINS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    calibrated_bins.to_string(\n",
    "        index=False,\n",
    "        float_format=lambda x: f\"{x:.4f}\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 9. Create reliability diagram\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "plt.figure(figsize=(8, 7))\n",
    "\n",
    "# Perfect calibration reference line\n",
    "plt.plot(\n",
    "    [0, 1],\n",
    "    [0, 1],\n",
    "    linestyle=\"--\",\n",
    "    label=\"Perfect Calibration\"\n",
    ")\n",
    "\n",
    "# Raw model\n",
    "plt.plot(\n",
    "    raw_bins[\"mean_predicted\"],\n",
    "    raw_bins[\"observed_rate\"],\n",
    "    marker=\"o\",\n",
    "    linewidth=2,\n",
    "    label=\"Raw Gradient Boosting\"\n",
    ")\n",
    "\n",
    "# Calibrated model\n",
    "plt.plot(\n",
    "    calibrated_bins[\"mean_predicted\"],\n",
    "    calibrated_bins[\"observed_rate\"],\n",
    "    marker=\"o\",\n",
    "    linewidth=2,\n",
    "    label=\"Isotonic Calibrated\"\n",
    ")\n",
    "\n",
    "plt.xlabel(\n",
    "    \"Mean Predicted Cancellation Probability\"\n",
    ")\n",
    "\n",
    "plt.ylabel(\n",
    "    \"Observed Cancellation Rate\"\n",
    ")\n",
    "\n",
    "plt.title(\n",
    "    \"Reliability Diagram: Raw vs Isotonic-Calibrated Model\"\n",
    ")\n",
    "\n",
    "plt.legend()\n",
    "\n",
    "plt.grid(\n",
    "    alpha=0.3\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 10. Save test probability results\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "test_probability_df = pd.DataFrame({\n",
    "\n",
    "    \"actual_cancelled\":\n",
    "        y_test.values,\n",
    "\n",
    "    \"raw_cancel_probability\":\n",
    "        test_raw_prob,\n",
    "\n",
    "    \"calibrated_cancel_probability\":\n",
    "        test_calibrated_prob,\n",
    "\n",
    "    \"raw_show_probability\":\n",
    "        1 - test_raw_prob,\n",
    "\n",
    "    \"calibrated_show_probability\":\n",
    "        1 - test_calibrated_prob\n",
    "})\n",
    "\n",
    "\n",
    "test_probability_df.to_csv(\n",
    "    \"test_calibration_probabilities.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "test_calibration_comparison.to_csv(\n",
    "    \"test_calibration_comparison.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "raw_bins.to_csv(\n",
    "    \"raw_reliability_bins.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "calibrated_bins.to_csv(\n",
    "    \"calibrated_reliability_bins.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"FILES SAVED\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\"test_calibration_probabilities.csv\")\n",
    "print(\"test_calibration_comparison.csv\")\n",
    "print(\"raw_reliability_bins.csv\")\n",
    "print(\"calibrated_reliability_bins.csv\")\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"STEP 9 COMPLETE\")\n",
    "print(\"=\" * 70)"
   ]
