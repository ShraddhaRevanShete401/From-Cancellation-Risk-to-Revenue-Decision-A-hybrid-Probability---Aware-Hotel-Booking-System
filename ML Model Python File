    "#   4. Test probability alignment\n",
    "#   5. Business simulation consistency\n",
    "#   6. Policy scenario coverage\n",
    "#   7. Key dataset assumptions / limitations\n",
    "#   8. Final reproducibility inventory\n",
    "# ================================================================\n",
    "\n",
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"STEP 21 — FINAL METHODOLOGY & ROBUSTNESS AUDIT\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "audit_results = []\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 1. TEMPORAL TRAIN / TEST SEPARATION\n",
    "# ------------------------------------------------\n",
    "\n",
    "train_dates = pd.to_datetime(\n",
    "    train_df[\"arrival_date_full\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "validation_dates = pd.to_datetime(\n",
    "    validation_df[\"arrival_date_full\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "calibration_dates = pd.to_datetime(\n",
    "    calibration_df[\"arrival_date_full\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "test_dates = pd.to_datetime(\n",
    "    test_df[\"arrival_date_full\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "train_max = train_dates.max()\n",
    "validation_min = validation_dates.min()\n",
    "validation_max = validation_dates.max()\n",
    "calibration_min = calibration_dates.min()\n",
    "calibration_max = calibration_dates.max()\n",
    "test_min = test_dates.min()\n",
    "\n",
    "temporal_order_ok = (\n",
    "    train_max < validation_min\n",
    "    and\n",
    "    validation_max < calibration_min\n",
    "    and\n",
    "    calibration_max < test_min\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"1. TEMPORAL SPLIT CHECK\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    \"Train:\",\n",
    "    train_dates.min().date(),\n",
    "    \"to\",\n",
    "    train_max.date()\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Validation:\",\n",
    "    validation_min.date(),\n",
    "    \"to\",\n",
    "    validation_max.date()\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Calibration:\",\n",
    "    calibration_min.date(),\n",
    "    \"to\",\n",
    "    calibration_max.date()\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Test:\",\n",
    "    test_min.date(),\n",
    "    \"to\",\n",
    "    test_dates.max().date()\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Temporal order valid:\",\n",
    "    temporal_order_ok\n",
    ")\n",
    "\n",
    "audit_results.append({\n",
    "    \"check\": \"Temporal train/validation/calibration/test order\",\n",
    "    \"status\": temporal_order_ok\n",
    "})\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 2. DATE OVERLAP CHECK\n",
    "# ------------------------------------------------\n",
    "\n",
    "train_date_set = set(\n",
    "    train_dates.dt.date\n",
    ")\n",
    "\n",
    "validation_date_set = set(\n",
    "    validation_dates.dt.date\n",
    ")\n",
    "\n",
    "calibration_date_set = set(\n",
    "    calibration_dates.dt.date\n",
    ")\n",
    "\n",
    "test_date_set = set(\n",
    "    test_dates.dt.date\n",
    ")\n",
    "\n",
    "date_overlap_count = (\n",
    "    len(\n",
    "        train_date_set &\n",
    "        validation_date_set\n",
    "    )\n",
    "    +\n",
    "    len(\n",
    "        train_date_set &\n",
    "        calibration_date_set\n",
    "    )\n",
    "    +\n",
    "    len(\n",
    "        train_date_set &\n",
    "        test_date_set\n",
    "    )\n",
    "    +\n",
    "    len(\n",
    "        validation_date_set &\n",
    "        calibration_date_set\n",
    "    )\n",
    "    +\n",
    "    len(\n",
    "        validation_date_set &\n",
    "        test_date_set\n",
    "    )\n",
    "    +\n",
    "    len(\n",
    "        calibration_date_set &\n",
    "        test_date_set\n",
    "    )\n",
    ")\n",
    "\n",
    "date_overlap_ok = (\n",
    "    date_overlap_count == 0\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nDate-overlap violations:\",\n",
    "    date_overlap_count\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Date separation valid:\",\n",
    "    date_overlap_ok\n",
    ")\n",
    "\n",
    "audit_results.append({\n",
    "    \"check\": \"No arrival-date overlap across splits\",\n",
    "    \"status\": date_overlap_ok\n",
    "})\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 3. HYBRID WEIGHT CHECK\n",
    "# ------------------------------------------------\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"2. FROZEN HYBRID WEIGHT CHECK\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    \"ML weight:\",\n",
    "    selected_alpha\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Historical weight:\",\n",
    "    selected_historical_weight\n",
    ")\n",
    "\n",
    "hybrid_weight_ok = (\n",
    "    np.isclose(\n",
    "        selected_alpha,\n",
    "        0.55\n",
    "    )\n",
    "    and\n",
    "    np.isclose(\n",
    "        selected_historical_weight,\n",
    "        0.45\n",
    "    )\n",
    "    and\n",
    "    np.isclose(\n",
    "        selected_alpha +\n",
    "        selected_historical_weight,\n",
    "        1.0\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Frozen 55/45 weighting:\",\n",
    "    hybrid_weight_ok\n",
    ")\n",
    "\n",
    "audit_results.append({\n",
    "    \"check\": \"Hybrid weights sum to 1 and match validation selection\",\n",
    "    \"status\": hybrid_weight_ok\n",
    "})\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 4. TEST PROBABILITY ALIGNMENT\n",
    "# ------------------------------------------------\n",
    "\n",
    "final_probability_file = (\n",
    "    \"final_test_hybrid_probabilities.csv\"\n",
    ")\n",
    "\n",
    "probability_file_exists = os.path.exists(\n",
    "    final_probability_file\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"3. TEST PROBABILITY ALIGNMENT\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    \"Probability file exists:\",\n",
    "    probability_file_exists\n",
    ")\n",
    "\n",
    "if probability_file_exists:\n",
    "\n",
    "    final_probs = pd.read_csv(\n",
    "        final_probability_file\n",
    "    )\n",
    "\n",
    "    test_ids = set(\n",
    "        test_df[\"Booking_ID\"]\n",
    "    )\n",
    "\n",
    "    probability_ids = set(\n",
    "        final_probs[\"Booking_ID\"]\n",
    "    )\n",
    "\n",
    "    missing_ids = (\n",
    "        test_ids -\n",
    "        probability_ids\n",
    "    )\n",
    "\n",
    "    extra_ids = (\n",
    "        probability_ids -\n",
    "        test_ids\n",
    "    )\n",
    "\n",
    "    probability_alignment_ok = (\n",
    "        len(missing_ids) == 0\n",
    "        and\n",
    "        len(extra_ids) == 0\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Test rows:\",\n",
    "        len(test_df)\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Probability rows:\",\n",
    "        len(final_probs)\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Missing Booking IDs:\",\n",
    "        len(missing_ids)\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Extra Booking IDs:\",\n",
    "        len(extra_ids)\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Probability alignment valid:\",\n",
    "        probability_alignment_ok\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    probability_alignment_ok = False\n",
    "\n",
    "    print(\n",
    "        \"Probability alignment cannot be checked.\"\n",
    "    )\n",
    "\n",
    "audit_results.append({\n",
    "    \"check\": \"Final test probabilities align with test bookings\",\n",
    "    \"status\": probability_alignment_ok\n",
    "})\n",
    "\n",
    "# ------------------------------------------------\n",
