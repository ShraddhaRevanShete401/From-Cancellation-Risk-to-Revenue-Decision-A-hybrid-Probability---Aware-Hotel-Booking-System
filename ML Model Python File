    "# ============================================================\n",
    "# STEP 10: PREPARE BOOKING-LEVEL PROBABILITIES\n",
    "#             FOR OVERBOOKING SIMULATION\n",
    "# ============================================================\n",
    "#\n",
    "# Goal:\n",
    "# Convert cancellation probabilities into individual\n",
    "# booking-level SHOW probabilities.\n",
    "#\n",
    "# We will create two versions:\n",
    "#\n",
    "#   1. Raw Gradient Boosting probabilities\n",
    "#   2. Isotonic-calibrated probabilities\n",
    "#\n",
    "# These will later feed the Poisson-binomial overbooking model.\n",
    "#\n",
    "# IMPORTANT:\n",
    "# The TEST probabilities are already generated from the\n",
    "# untouched test set. We are NOT fitting anything here.\n",
    "# ============================================================\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 1. Start from the TEST booking records\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "overbooking_test = test_df.copy()\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 2. Add raw cancellation probability\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "overbooking_test[\"raw_cancel_prob\"] = (\n",
    "    test_raw_prob\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 3. Add calibrated cancellation probability\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "overbooking_test[\"calibrated_cancel_prob\"] = (\n",
    "    test_calibrated_prob\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 4. Convert cancellation probability into SHOW probability\n",
    "# ------------------------------------------------------------\n",
    "#\n",
    "# P(show) = 1 - P(cancel)\n",
    "#\n",
    "# These are the probabilities we will use in the\n",
    "# Poisson-binomial distribution.\n",
    "\n",
    "overbooking_test[\"raw_show_prob\"] = (\n",
    "    1 - overbooking_test[\"raw_cancel_prob\"]\n",
    ")\n",
    "\n",
    "overbooking_test[\"calibrated_show_prob\"] = (\n",
    "    1 - overbooking_test[\"calibrated_cancel_prob\"]\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 5. Add actual show outcome\n",
    "# ------------------------------------------------------------\n",
    "# IMPORTANT LIMITATION:\n",
    "#\n",
    "# The dataset records:\n",
    "#   Canceled\n",
    "#   Not_Canceled\n",
    "#\n",
    "# It does NOT directly record whether the guest actually\n",
    "# showed up.\n",
    "#\n",
    "# Therefore, for this simulation we use:\n",
    "#\n",
    "#   Not_Canceled -> Show\n",
    "#   Canceled     -> No-show\n",
    "#\n",
    "# This assumption must be explicitly stated as a limitation\n",
    "# in the final paper.\n",
    "\n",
    "overbooking_test[\"actual_show\"] = (\n",
    "    1 - overbooking_test[\"target_cancelled\"]\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 6. Create booking value\n",
    "# ------------------------------------------------------------\n",
    "# We already created estimated_booking_value during cleaning.\n",
    "#\n",
    "# This represents:\n",
    "#\n",
    "#     ADR × number of nights\n",
    "#\n",
    "# We retain it for later business analysis.\n",
    "\n",
    "if \"estimated_booking_value\" in overbooking_test.columns:\n",
    "\n",
    "    overbooking_test[\"booking_value\"] = (\n",
    "        overbooking_test[\"estimated_booking_value\"]\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    overbooking_test[\"booking_value\"] = (\n",
    "        overbooking_test[\"avg_price_per_room\"]\n",
    "        * overbooking_test[\"total_nights\"]\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 7. Create a simple booking identifier\n",
    "# ------------------------------------------------------------\n",
    "# Booking_ID is NOT used by the ML model.\n",
    "#\n",
    "# Here it is retained only so we can trace observations\n",
    "# during simulation.\n",
    "\n",
    "if \"Booking_ID\" in overbooking_test.columns:\n",
    "\n",
    "    overbooking_test[\"simulation_booking_id\"] = (\n",
    "        overbooking_test[\"Booking_ID\"]\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    overbooking_test[\"simulation_booking_id\"] = (\n",
    "        overbooking_test.index\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 8. Check probability validity\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"PROBABILITY VALIDATION\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    \"Raw show probability outside [0,1]:\",\n",
    "    (\n",
    "        (overbooking_test[\"raw_show_prob\"] < 0) |\n",
    "        (overbooking_test[\"raw_show_prob\"] > 1)\n",
    "    ).sum()\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Calibrated show probability outside [0,1]:\",\n",
    "    (\n",
    "        (overbooking_test[\"calibrated_show_prob\"] < 0) |\n",
    "        (overbooking_test[\"calibrated_show_prob\"] > 1)\n",
    "    ).sum()\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 9. Display probability summaries\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "probability_summary = pd.DataFrame({\n",
    "\n",
    "    \"Probability_Type\": [\n",
    "        \"Raw cancellation\",\n",
    "        \"Calibrated cancellation\",\n",
    "        \"Raw show\",\n",
    "        \"Calibrated show\"\n",
    "    ],\n",
    "\n",
    "    \"Mean\": [\n",
    "        overbooking_test[\"raw_cancel_prob\"].mean(),\n",
    "        overbooking_test[\"calibrated_cancel_prob\"].mean(),\n",
    "        overbooking_test[\"raw_show_prob\"].mean(),\n",
    "        overbooking_test[\"calibrated_show_prob\"].mean()\n",
    "    ],\n",
    "\n",
    "    \"Minimum\": [\n",
    "        overbooking_test[\"raw_cancel_prob\"].min(),\n",
    "        overbooking_test[\"calibrated_cancel_prob\"].min(),\n",
    "        overbooking_test[\"raw_show_prob\"].min(),\n",
    "        overbooking_test[\"calibrated_show_prob\"].min()\n",
    "    ],\n",
    "\n",
    "    \"Maximum\": [\n",
    "        overbooking_test[\"raw_cancel_prob\"].max(),\n",
    "        overbooking_test[\"calibrated_cancel_prob\"].max(),\n",
    "        overbooking_test[\"raw_show_prob\"].max(),\n",
    "        overbooking_test[\"calibrated_show_prob\"].max()\n",
    "    ]\n",
    "})\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"PROBABILITY SUMMARY\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    probability_summary.to_string(\n",
    "        index=False,\n",
    "        float_format=lambda x: f\"{x:.4f}\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 10. Compare predicted show probability with actual show rate\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"PREDICTED VS ACTUAL SHOW RATE\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    \"Actual show rate:\",\n",
    "    f\"{overbooking_test['actual_show'].mean():.4f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Mean raw show probability:\",\n",
    "    f\"{overbooking_test['raw_show_prob'].mean():.4f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Mean calibrated show probability:\",\n",
    "    f\"{overbooking_test['calibrated_show_prob'].mean():.4f}\"\n",
    ")\n",
