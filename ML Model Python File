    "# ================================================================\n",
    "# STEP 16 — VALIDATION-BASED HYBRID WEIGHT SELECTION\n",
    "# ================================================================\n",
    "# Purpose:\n",
    "#   Select the ML/historical probability blend WITHOUT using\n",
    "#   the final TEST set.\n",
    "#\n",
    "# IMPORTANT FIX:\n",
    "#   Do NOT remove zero-night bookings here.\n",
    "#\n",
    "#   X_validation contains every row in validation_df, so the\n",
    "#   target vector must contain exactly the same rows in the\n",
    "#   same order.\n",
    "#\n",
    "#   Zero-night bookings will continue to be excluded later from\n",
    "#   the ROOM INVENTORY / OVERBOOKING simulation.\n",
    "#\n",
    "# Hybrid:\n",
    "#\n",
    "#   p_hybrid = alpha * p_calibrated\n",
    "#             + (1-alpha) * p_historical\n",
    "#\n",
    "# alpha = 0:\n",
    "#     100% historical baseline\n",
    "#\n",
    "# alpha = 1:\n",
    "#     100% calibrated ML\n",
    "#\n",
    "# Alpha is selected using VALIDATION Brier score only.\n",
    "# The TEST set remains untouched.\n",
    "# ================================================================\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"STEP 16 — VALIDATION-BASED HYBRID WEIGHT SELECTION\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 1. ALIGN VALIDATION TARGETS WITH X_VALIDATION\n",
    "# ------------------------------------------------\n",
    "# IMPORTANT:\n",
    "# X_validation was created from validation_df without\n",
    "# removing any rows.\n",
    "#\n",
    "# Therefore use validation_df directly here.\n",
    "\n",
    "validation_actual_cancelled = (\n",
    "    validation_df[\"target_cancelled\"]\n",
    "    .to_numpy()\n",
    ")\n",
    "\n",
    "print(\"\\nValidation probability rows:\",\n",
    "      len(X_validation))\n",
    "\n",
    "print(\"Validation target rows:\",\n",
    "      len(validation_actual_cancelled))\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 2. CHECK ROW ALIGNMENT\n",
    "# ------------------------------------------------\n",
    "if len(X_validation) != len(\n",
    "    validation_actual_cancelled\n",
    "):\n",
    "    raise ValueError(\n",
    "        \"Validation probability and target lengths \"\n",
    "        \"still do not match.\"\n",
    "    )\n",
    "\n",
    "print(\"STATUS: VALIDATION ROW COUNTS MATCH\")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 3. HISTORICAL BASELINE\n",
    "# ------------------------------------------------\n",
    "# Historical cancellation probability is estimated ONLY\n",
    "# from the TRAINING period.\n",
    "\n",
    "historical_cancel_probability = (\n",
    "    train_df[\"target_cancelled\"].mean()\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"\\nHistorical training cancellation probability: \"\n",
    "    f\"{historical_cancel_probability:.4f}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 4. GENERATE VALIDATION RAW ML PROBABILITIES\n",
    "# ------------------------------------------------\n",
    "# best_model:\n",
    "#   trained only on TRAIN.\n",
    "#\n",
    "# Therefore validation data remains unseen by the model.\n",
    "\n",
    "validation_raw_cancel_prob = (\n",
    "    best_model.predict_proba(\n",
    "        X_validation\n",
    "    )[:, 1]\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 5. APPLY THE PREVIOUSLY FIT ISOTONIC CALIBRATOR\n",
    "# ------------------------------------------------\n",
    "# isotonic_calibrator was fitted using the separate\n",
    "# CALIBRATION set.\n",
    "#\n",
    "# It was NOT fitted on validation data.\n",
    "\n",
    "validation_calibrated_cancel_prob = (\n",
    "    isotonic_calibrator.predict(\n",
    "        validation_raw_cancel_prob\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 6. SANITY CHECK PROBABILITY ARRAYS\n",
    "# ------------------------------------------------\n",
    "if len(validation_raw_cancel_prob) != len(\n",
    "    validation_actual_cancelled\n",
    "):\n",
    "    raise ValueError(\n",
    "        \"Raw validation probabilities do not match \"\n",
    "        \"validation targets.\"\n",
    "    )\n",
    "\n",
    "if len(validation_calibrated_cancel_prob) != len(\n",
    "    validation_actual_cancelled\n",
    "):\n",
    "    raise ValueError(\n",
    "        \"Calibrated validation probabilities do not \"\n",
    "        \"match validation targets.\"\n",
    "    )\n",
    "\n",
    "print(\n",
    "    \"Raw validation probability rows:\",\n",
    "    len(validation_raw_cancel_prob)\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Calibrated validation probability rows:\",\n",
    "    len(validation_calibrated_cancel_prob)\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Actual validation target rows:\",\n",
    "    len(validation_actual_cancelled)\n",
    ")\n",
    "\n",
    "print(\"STATUS: ALL VALIDATION ARRAYS ALIGNED\")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 7. ACTUAL VALIDATION CANCELLATION RATE\n",
    "# ------------------------------------------------\n",
    "actual_validation_cancel_rate = (\n",
    "    validation_actual_cancelled.mean()\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"\\nActual validation cancellation rate: \"\n",
    "    f\"{actual_validation_cancel_rate:.4f}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 8. EVALUATE HYBRID WEIGHTS\n",
    "# ------------------------------------------------\n",
    "# We use a finer grid than before:\n",
    "#\n",
    "# alpha = 0.00 -> 100% historical\n",
    "# alpha = 0.05 -> 5% ML / 95% historical\n",
    "# ...\n",
    "# alpha = 1.00 -> 100% calibrated ML\n",
    "\n",
    "alpha_values = np.arange(\n",
    "    0.0,\n",
    "    1.01,\n",
    "    0.05\n",
    ")\n",
    "\n",
    "validation_rows = []\n",
    "\n",
    "\n",
    "for alpha in alpha_values:\n",
    "\n",
    "    # ------------------------------------------------\n",
    "    # HYBRID CANCELLATION PROBABILITY\n",
    "    # ------------------------------------------------\n",
    "    hybrid_probability = (\n",
    "        alpha *\n",
    "        validation_calibrated_cancel_prob\n",
    "        +\n",
    "        (1 - alpha) *\n",
    "        historical_cancel_probability\n",
    "    )\n",
    "\n",
    "    # Numerical safety\n",
    "    hybrid_probability = np.clip(\n",
    "        hybrid_probability,\n",
    "        0.0,\n",
    "        1.0\n",
    "    )\n",
    "\n",
    "\n",
    "    # ------------------------------------------------\n",
    "    # BRIER SCORE\n",
    "    # ------------------------------------------------\n",
    "    brier_score = np.mean(\n",
    "        (\n",
    "            hybrid_probability -\n",
    "            validation_actual_cancelled\n",
    "        ) ** 2\n",
    "    )\n",
    "\n",
    "\n",
    "    # ------------------------------------------------\n",
    "    # LOG LOSS\n",
    "    # ------------------------------------------------\n",
    "    epsilon = 1e-15\n",
    "\n",
    "    clipped_probability = np.clip(\n",
    "        hybrid_probability,\n",
    "        epsilon,\n",
    "        1 - epsilon\n",
    "    )\n",
    "\n",
    "    log_loss = -np.mean(\n",
    "        validation_actual_cancelled *\n",
    "        np.log(clipped_probability)\n",
    "        +\n",
    "        (\n",
    "            1 -\n",
    "            validation_actual_cancelled\n",
    "        ) *\n",
    "        np.log(\n",
    "            1 -\n",
    "            clipped_probability\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # ------------------------------------------------\n",
    "    # MEAN PROBABILITY\n",
    "    # ------------------------------------------------\n",
    "    mean_probability = (\n",
    "        hybrid_probability.mean()\n",
    "    )\n",
    "\n",
    "    bias = (\n",
    "        mean_probability -\n",
    "        actual_validation_cancel_rate\n",
    "    )\n",
    "\n",
    "\n",
    "    validation_rows.append({\n",
    "        \"alpha_ml\": alpha,\n",
    "        \"alpha_historical\": 1 - alpha,\n",
    "        \"mean_cancel_probability\": mean_probability,\n",
    "        \"actual_validation_cancel_rate\":\n",
    "            actual_validation_cancel_rate,\n",
    "        \"bias\": bias,\n",
    "        \"absolute_bias\": abs(bias),\n",
    "        \"brier_score\": brier_score,\n",
    "        \"log_loss\": log_loss\n",
    "    })\n",
    "\n",
    "\n",
    "validation_hybrid_results = pd.DataFrame(\n",
    "    validation_rows\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 9. SELECT ALPHA USING VALIDATION BRIER SCORE\n",
    "# ------------------------------------------------\n",
    "best_validation_brier = (\n",
    "    validation_hybrid_results\n",
    "    .sort_values(\n",
    "        [\n",
    "            \"brier_score\",\n",
    "            \"alpha_ml\"\n",
    "        ],\n",
    "        ascending=[\n",
    "            True,\n",
    "            True\n",
    "        ]\n",
    "    )\n",
    "    .iloc[0]\n",
    ")\n",
    "\n",
    "selected_alpha = float(\n",
    "    best_validation_brier[\"alpha_ml\"]\n",
    ")\n",
    "\n",
    "selected_historical_weight = float(\n",
    "    best_validation_brier[\n",
    "        \"alpha_historical\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 10. FIND LOG-LOSS OPTIMUM FOR REFERENCE\n",
    "# ------------------------------------------------\n",
    "best_validation_logloss = (\n",
    "    validation_hybrid_results\n",
    "    .sort_values(\n",
    "        [\n",
    "            \"log_loss\",\n",
    "            \"alpha_ml\"\n",
    "        ],\n",
    "        ascending=[\n",
    "            True,\n",
    "            True\n",
    "        ]\n",
    "    )\n",
    "    .iloc[0]\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 11. DISPLAY COMPLETE RESULTS\n",
    "# ------------------------------------------------\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"VALIDATION HYBRID RESULTS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    validation_hybrid_results\n",
    "    .round(4)\n",
    "    .to_string(index=False)\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 12. DISPLAY SELECTED MODEL\n",
    "# ------------------------------------------------\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"SELECTED HYBRID WEIGHT\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    f\"ML weight: \"\n",
    "    f\"{selected_alpha:.2f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Historical weight: \"\n",
    "    f\"{selected_historical_weight:.2f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Validation Brier score: \"\n",
    "    f\"{best_validation_brier['brier_score']:.4f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Validation log-loss: \"\n",
    "    f\"{best_validation_brier['log_loss']:.4f}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 13. LOG-LOSS OPTIMUM — REFERENCE ONLY\n",
    "# ------------------------------------------------\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"VALIDATION LOG-LOSS OPTIMUM — REFERENCE\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    f\"ML weight: \"\n",
    "    f\"{best_validation_logloss['alpha_ml']:.2f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Historical weight: \"\n",
    "    f\"{best_validation_logloss['alpha_historical']:.2f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Log-loss: \"\n",
    "    f\"{best_validation_logloss['log_loss']:.4f}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 14. SAVE SELECTED CONFIGURATION\n",
    "# ------------------------------------------------\n",
    "hybrid_model_config = {\n",
    "    \"selected_alpha_ml\": selected_alpha,\n",
    "    \"selected_alpha_historical\":\n",
    "        selected_historical_weight,\n",
    "    \"selection_metric\":\n",
    "        \"Validation Brier Score\"\n",
    "}\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"HYBRID MODEL CONFIGURATION\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(hybrid_model_config)\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 15. SAVE RESULTS\n",
    "# ------------------------------------------------\n",
    "validation_hybrid_results.to_csv(\n",
    "    \"validation_hybrid_weight_selection.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "pd.DataFrame(\n",
    "    [hybrid_model_config]\n",
    ").to_csv(\n",
    "    \"selected_hybrid_model_config.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"FILES SAVED\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    \"validation_hybrid_weight_selection.csv\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"selected_hybrid_model_config.csv\"\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"STEP 16 COMPLETE\")\n",
    "print(\"=\" * 70)"
