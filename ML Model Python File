    "        )\n",
    "\n",
    "        n_demand = len(day_df)\n",
    "\n",
    "        # ------------------------------------------------\n",
    "        # Determine optimal accepted prefix.\n",
    "        # ------------------------------------------------\n",
    "\n",
    "        if policy_name == \"No Overbooking\":\n",
    "\n",
    "            accepted_count = min(\n",
    "                capacity,\n",
    "                n_demand\n",
    "            )\n",
    "\n",
    "        elif policy_name == \"Expected Shows\":\n",
    "\n",
    "            cumulative_expected_shows = np.cumsum(\n",
    "                show_probabilities\n",
    "            )\n",
    "\n",
    "            feasible = np.where(\n",
    "                cumulative_expected_shows <= capacity\n",
    "            )[0]\n",
    "\n",
    "            if len(feasible) == 0:\n",
    "\n",
    "                accepted_count = 0\n",
    "\n",
    "            else:\n",
    "\n",
    "                accepted_count = (\n",
    "                    feasible[-1] + 1\n",
    "                )\n",
    "\n",
    "        else:\n",
    "\n",
    "            # Newsvendor-style expected-profit optimization\n",
    "            best_profit = -np.inf\n",
    "            best_count = 0\n",
    "\n",
    "            for prefix_count in range(\n",
    "                1,\n",
    "                n_demand + 1\n",
    "            ):\n",
    "\n",
    "                result = evaluate_prefix_profit(\n",
    "                    show_probabilities[\n",
    "                        :prefix_count\n",
    "                    ],\n",
    "                    capacity,\n",
    "                    training_adr,\n",
    "                    walk_cost\n",
    "                )\n",
    "\n",
    "                if result[\"expected_profit\"] > best_profit:\n",
    "\n",
    "                    best_profit = (\n",
    "                        result[\"expected_profit\"]\n",
    "                    )\n",
    "\n",
    "                    best_count = (\n",
    "                        prefix_count\n",
    "                    )\n",
    "\n",
    "            accepted_count = best_count\n",
    "\n",
    "        accepted_actual = (\n",
    "            actual_show[:accepted_count]\n",
    "        )\n",
    "\n",
    "        actual_show_count = (\n",
    "            accepted_actual.sum()\n",
    "        )\n",
    "\n",
    "        actual_walks = max(\n",
    "            actual_show_count - capacity,\n",
    "            0\n",
    "        )\n",
    "\n",
    "        actual_empty = max(\n",
    "            capacity - actual_show_count,\n",
    "            0\n",
    "        )\n",
    "\n",
    "        actual_revenue = (\n",
    "            training_adr *\n",
    "            min(\n",
    "                actual_show_count,\n",
    "                capacity\n",
    "            )\n",
    "        )\n",
    "\n",
    "        actual_walk_cost = (\n",
    "            walk_cost *\n",
    "            actual_walks\n",
    "        )\n",
    "\n",
    "        actual_profit = (\n",
    "            actual_revenue -\n",
    "            actual_walk_cost\n",
    "        )\n",
    "\n",
    "        total_accepted += accepted_count\n",
    "        total_actual_shows += actual_show_count\n",
    "        total_walks += actual_walks\n",
    "        total_empty += actual_empty\n",
    "        total_revenue += actual_revenue\n",
    "        total_walk_cost += actual_walk_cost\n",
    "        total_profit += actual_profit\n",
    "\n",
    "        daily_records.append({\n",
    "            \"arrival_date\": arrival_date,\n",
    "            \"policy\": policy_name,\n",
    "            \"capacity\": capacity,\n",
    "            \"walk_cost\": walk_cost,\n",
    "            \"demand\": n_demand,\n",
    "            \"accepted\": accepted_count,\n",
    "            \"actual_shows\": actual_show_count,\n",
    "            \"walks\": actual_walks,\n",
    "            \"empty_rooms\": actual_empty,\n",
    "            \"revenue\": actual_revenue,\n",
    "            \"walk_cost_total\": actual_walk_cost,\n",
    "            \"profit\": actual_profit\n",
    "        })\n",
    "\n",
    "    summary = {\n",
    "        \"policy\": policy_name,\n",
    "        \"capacity\": capacity,\n",
    "        \"walk_cost\": walk_cost,\n",
    "        \"accepted\": total_accepted,\n",
    "        \"actual_shows\": total_actual_shows,\n",
    "        \"walks\": total_walks,\n",
    "        \"empty_rooms\": total_empty,\n",
    "        \"revenue\": total_revenue,\n",
    "        \"walk_cost_total\": total_walk_cost,\n",
    "        \"profit\": total_profit,\n",
    "        \"profit_per_day\": (\n",
    "            total_profit /\n",
    "            len(daily_bookings)\n",
    "        )\n",
    "    }\n",
    "\n",
    "    return (\n",
    "        summary,\n",
    "        pd.DataFrame(daily_records)\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 10. RUN ALL POLICIES × SCENARIOS\n",
    "# ------------------------------------------------\n",
    "\n",
    "all_results = []\n",
