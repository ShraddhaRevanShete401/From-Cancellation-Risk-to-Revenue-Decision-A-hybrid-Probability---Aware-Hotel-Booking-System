    "# ------------------------------------------------\n",
    "# 7. POISSON-BINOMIAL PMF\n",
    "# ------------------------------------------------\n",
    "\n",
    "def poisson_binomial_pmf(probabilities):\n",
    "\n",
    "    probabilities = np.asarray(\n",
    "        probabilities,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    pmf = np.array([1.0])\n",
    "\n",
    "    for p in probabilities:\n",
    "\n",
    "        new_pmf = np.zeros(\n",
    "            len(pmf) + 1\n",
    "        )\n",
    "\n",
    "        new_pmf[:-1] += pmf * (1 - p)\n",
    "        new_pmf[1:] += pmf * p\n",
    "\n",
    "        pmf = new_pmf\n",
    "\n",
    "    return pmf\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 8. EXPECTED PROFIT FOR AN ACCEPTANCE PREFIX\n",
    "# ------------------------------------------------\n",
    "\n",
    "def evaluate_prefix_profit(\n",
    "    show_probabilities,\n",
    "    capacity,\n",
    "    room_revenue,\n",
    "    walk_cost\n",
    "):\n",
    "\n",
    "    n = len(show_probabilities)\n",
    "\n",
    "    if n == 0:\n",
    "        return {\n",
    "            \"accepted\": 0,\n",
    "            \"expected_shows\": 0.0,\n",
    "            \"expected_empty\": 0.0,\n",
    "            \"expected_walks\": 0.0,\n",
    "            \"expected_revenue\": 0.0,\n",
    "            \"expected_walk_cost\": 0.0,\n",
    "            \"expected_profit\": 0.0\n",
    "        }\n",
    "\n",
    "    pmf = poisson_binomial_pmf(\n",
    "        show_probabilities\n",
    "    )\n",
    "\n",
    "    outcomes = np.arange(\n",
    "        n + 1\n",
    "    )\n",
    "\n",
    "    accepted_show_count = np.minimum(\n",
    "        outcomes,\n",
    "        capacity\n",
    "    )\n",
    "\n",
    "    walks = np.maximum(\n",
    "        outcomes - capacity,\n",
    "        0\n",
    "    )\n",
    "\n",
    "    empty_rooms = np.maximum(\n",
    "        capacity - outcomes,\n",
    "        0\n",
    "    )\n",
    "\n",
    "    expected_shows = np.sum(\n",
    "        outcomes * pmf\n",
    "    )\n",
    "\n",
    "    expected_empty = np.sum(\n",
    "        empty_rooms * pmf\n",
    "    )\n",
    "\n",
    "    expected_walks = np.sum(\n",
    "        walks * pmf\n",
    "    )\n",
    "\n",
    "    expected_revenue = (\n",
    "        room_revenue *\n",
    "        np.sum(\n",
    "            accepted_show_count * pmf\n",
    "        )\n",
    "    )\n",
    "\n",
    "    expected_walk_cost = (\n",
    "        walk_cost *\n",
    "        expected_walks\n",
    "    )\n",
    "\n",
    "    expected_profit = (\n",
    "        expected_revenue -\n",
    "        expected_walk_cost\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        \"accepted\": n,\n",
    "        \"expected_shows\": expected_shows,\n",
    "        \"expected_empty\": expected_empty,\n",
    "        \"expected_walks\": expected_walks,\n",
    "        \"expected_revenue\": expected_revenue,\n",
    "        \"expected_walk_cost\": expected_walk_cost,\n",
    "        \"expected_profit\": expected_profit\n",
    "    }\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 9. DAILY POLICY SIMULATION\n",
    "# ------------------------------------------------\n",
    "\n",
    "def simulate_policy(\n",
    "    daily_bookings,\n",
    "    probability_column,\n",
    "    policy_name,\n",
    "    capacity,\n",
    "    walk_cost\n",
    "):\n",
    "\n",
    "    total_accepted = 0\n",
    "    total_actual_shows = 0\n",
    "    total_walks = 0\n",
    "    total_empty = 0\n",
    "    total_revenue = 0.0\n",
    "    total_walk_cost = 0.0\n",
    "    total_profit = 0.0\n",
    "\n",
    "    daily_records = []\n",
    "\n",
    "    for arrival_date, day_df in daily_bookings:\n",
    "\n",
    "        day_df = day_df.copy()\n",
    "\n",
    "        # ------------------------------------------------\n",
    "        # Approximate booking order:\n",
    "        # earliest estimated booking date first.\n",
    "        # ------------------------------------------------\n",
    "\n",
    "        if \"estimated_booking_date\" in day_df.columns:\n",
    "\n",
    "            day_df = day_df.sort_values(\n",
    "                \"estimated_booking_date\"\n",
    "            )\n",
    "\n",
    "        show_probabilities = (\n",
    "            day_df[probability_column]\n",
