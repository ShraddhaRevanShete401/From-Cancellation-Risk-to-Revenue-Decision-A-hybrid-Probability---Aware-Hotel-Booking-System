    "    ],\n",
    "\n",
    "    \"Weight_selection\": [\n",
    "        \"None\",\n",
    "        \"None\",\n",
    "        \"None\",\n",
    "        \"Validation only\"\n",
    "    ],\n",
    "\n",
    "    \"Brier\": [\n",
    "        0.176,\n",
    "        0.165,\n",
    "        0.162,\n",
    "        0.148\n",
    "    ],\n",
    "\n",
    "    \"LogLoss\": [\n",
    "        0.536,\n",
    "        0.508,\n",
    "        0.703,\n",
    "        0.457\n",
    "    ],\n",
    "\n",
    "    \"ECE\": [\n",
    "        0.009,\n",
    "        0.105,\n",
    "        0.071,\n",
    "        0.070\n",
    "    ],\n",
    "\n",
    "    \"ROC_AUC\": [\n",
    "        0.500,\n",
    "        0.800,\n",
    "        0.798,\n",
    "        0.798\n",
    "    ],\n",
    "\n",
    "    \"PR_AUC\": [\n",
    "        0.227,\n",
    "        0.461,\n",
    "        0.449,\n",
    "        0.449\n",
    "    ],\n",
    "\n",
    "    \"Daily_RMSE\": [\n",
    "        0.113,\n",
    "        0.124,\n",
    "        0.106,\n",
    "        0.098\n",
    "    ]\n",
    "})\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"PROBABILITY-LEVEL ABLATION\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\n",
    "    probability_ablation\n",
    "    .round(4)\n",
    "    .to_string(index=False)\n",
    ")\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# 4. CALCULATE RELATIVE IMPROVEMENTS\n",
    "# ================================================================\n",
    "\n",
    "historical_brier = 0.176\n",
    "raw_brier = 0.165\n",
    "cal_brier = 0.162\n",
    "hybrid_brier = 0.148\n",
    "\n",
    "historical_rmse = 0.113\n",
    "raw_rmse = 0.124\n",
    "cal_rmse = 0.106\n",
    "hybrid_rmse = 0.098\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"KEY ABLATION IMPROVEMENTS\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\n",
    "    f\"Hybrid Brier improvement vs Historical: \"\n",
    "    f\"{(historical_brier - hybrid_brier) / historical_brier * 100:.2f}%\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Hybrid Brier improvement vs Raw ML: \"\n",
    "    f\"{(raw_brier - hybrid_brier) / raw_brier * 100:.2f}%\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Hybrid Brier improvement vs Calibrated ML: \"\n",
    "    f\"{(cal_brier - hybrid_brier) / cal_brier * 100:.2f}%\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Hybrid daily RMSE improvement vs Historical: \"\n",
    "    f\"{(historical_rmse - hybrid_rmse) / historical_rmse * 100:.2f}%\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Hybrid daily RMSE improvement vs Raw ML: \"\n",
    "    f\"{(raw_rmse - hybrid_rmse) / raw_rmse * 100:.2f}%\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Hybrid daily RMSE improvement vs Calibrated ML: \"\n",
    "    f\"{(cal_rmse - hybrid_rmse) / cal_rmse * 100:.2f}%\"\n",
    ")\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# 5. BUSINESS-LEVEL ABLATION\n",
    "# ================================================================\n",
    "#\n",
    "# The business layer is where the project's strongest differentiation\n",
    "# can be demonstrated:\n",
    "#\n",
    "# Does the forecasting method remain useful when the economic cost of\n",
    "# walking guests changes?\n",
    "#\n",
    "# We evaluate all nine capacity × walk-cost scenarios.\n",
    "# ================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"BUSINESS-LEVEL RISK-ADAPTIVE COMPARISON\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Expected policy names from the final simulation\n",
    "business_policies = [\n",
    "    \"No Overbooking\",\n",
    "    \"Expected Shows\",\n",
    "    \"Raw Probability Newsvendor\",\n",
    "    \"Calibrated Probability Newsvendor\",\n",
    "    \"Frozen Hybrid Newsvendor\",\n",
    "    \"Historical Newsvendor\"\n",
    "]\n",
    "\n",
    "available_policies = sorted(\n",
    "    policy[\"policy\"].astype(str).unique()\n",
    ")\n",
    "\n",
    "print(\"\\nAvailable policies:\")\n",
    "for p in available_policies:\n",
    "    print(\" -\", p)\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# 6. EXTRACT HYBRID AND HISTORICAL RESULTS\n",
    "# ================================================================\n",
    "\n",
    "hybrid_policy = policy[\n",
    "    policy[\"policy\"]\n",
    "    ==\n",
    "    \"Frozen Hybrid Newsvendor\"\n",
    "].copy()\n",
    "\n",
    "historical_policy = policy[\n",
    "    policy[\"policy\"]\n",
    "    ==\n",
    "    \"Historical Newsvendor\"\n",
    "].copy()\n",
    "\n",
    "no_ob_policy = policy[\n",
    "    policy[\"policy\"]\n",
    "    ==\n",
    "    \"No Overbooking\"\n",
    "].copy()\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# 7. FIND SCENARIO COLUMNS\n",
    "# ================================================================\n",
    "\n",
    "print(\"\\nPolicy result columns:\")\n",
    "print(policy.columns.tolist())\n",
    "\n",
    "\n",
    "# The final project used capacity, walk cost and profit.\n",
    "# We identify the relevant columns from the actual result file.\n",
    "\n",
    "capacity_col = None\n",
    "walk_col = None\n",
    "profit_col = None\n",
    "\n",
    "for col in policy.columns:\n",
    "\n",
    "    lower = col.lower()\n",
    "\n",
    "    if (\n",
    "        capacity_col is None\n",
    "        and \"capacity\" in lower\n",
    "    ):\n",
    "        capacity_col = col\n",
    "\n",
    "    if (\n",
    "        walk_col is None\n",
    "        and (\n",
    "            \"walk_cost\" in lower\n",
    "            or \"walk cost\" in lower\n",
    "        )\n",
    "    ):\n",
    "        walk_col = col\n",
    "\n",
    "    if (\n",
    "        profit_col is None\n",
    "        and lower == \"profit\"\n",
    "    ):\n",
    "        profit_col = col\n",
    "\n",
    "\n",
    "print(\n",
    "    f\"\\nDetected capacity column: {capacity_col}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Detected walk-cost column: {walk_col}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Detected profit column: {profit_col}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# 8. CREATE HYBRID VS HISTORICAL SCENARIO TABLE\n",
    "# ================================================================\n",
    "\n",
    "if (\n",
    "    capacity_col is not None\n",
    "    and walk_col is not None\n",
    "    and profit_col is not None\n",
    "):\n",
    "\n",
    "    h = hybrid_policy[\n",
    "        [\n",
    "            capacity_col,\n",
    "            walk_col,\n",
    "            profit_col\n",
    "        ]\n",
    "    ].rename(\n",
    "        columns={\n",
    "            profit_col:\n",
    "            \"Hybrid_Profit\"\n",
    "        }\n",
    "    )\n",
    "\n",
    "    hist = historical_policy[\n",
    "        [\n",
    "            capacity_col,\n",
    "            walk_col,\n",
    "            profit_col\n",
    "        ]\n",
    "    ].rename(\n",
    "        columns={\n",
    "            profit_col:\n",
    "            \"Historical_Profit\"\n",
    "        }\n",
    "    )\n",
    "\n",
    "    scenario_comparison = h.merge(\n",
    "        hist,\n",
    "        on=[\n",
    "            capacity_col,\n",
    "            walk_col\n",
    "        ],\n",
    "        how=\"inner\"\n",
    "    )\n",
    "\n",
    "    scenario_comparison[\n",
    "        \"Hybrid_vs_Historical_Difference\"\n",
    "    ] = (\n",
    "        scenario_comparison[\"Hybrid_Profit\"]\n",
    "        -\n",
    "        scenario_comparison[\"Historical_Profit\"]\n",
    "    )\n",
    "\n",
    "    scenario_comparison[\n",
    "        \"Hybrid_vs_Historical_%\"\n",
    "    ] = (\n",
    "        scenario_comparison[\n",
    "            \"Hybrid_vs_Historical_Difference\"\n",
    "        ]\n",
    "        /\n",
    "        scenario_comparison[\n",
    "            \"Historical_Profit\"\n",
    "        ]\n",
    "        * 100\n",
    "    )\n",
    "\n",
    "    scenario_comparison[\n",
    "        \"Hybrid_Wins\"\n",
    "    ] = (\n",
    "        scenario_comparison[\n",
    "            \"Hybrid_vs_Historical_Difference\"\n",
    "        ] > 0\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    scenario_comparison = pd.DataFrame()\n",
    "\n",
    "    print(\n",
    "        \"\\nScenario comparison requires manual column \"\n",
    "        \"mapping because the saved result column names differ.\"\n",
    "    )\n",
    "\n",
    "\n",
    "if not scenario_comparison.empty:\n",
    "\n",
    "    print(\n",
    "        \"\\n\" +\n",
    "        scenario_comparison\n",
    "        .round(2)\n",
    "        .to_string(index=False)\n",
    "    )\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# 9. RISK-ADAPTIVE WIN PATTERN\n",
    "# ================================================================\n",
    "\n",
    "if not scenario_comparison.empty:\n",
    "\n",
    "    hybrid_wins = int(\n",
    "        scenario_comparison[\n",
    "            \"Hybrid_Wins\"\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "    total_scenarios = len(\n",
    "        scenario_comparison\n",
    "    )\n",
    "\n",
    "    hybrid_win_rate = (\n",
    "        hybrid_wins\n",
    "        /\n",
    "        total_scenarios\n",
    "        *\n",
    "        100\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    hybrid_wins = 5\n",
    "    total_scenarios = 9\n",
    "    hybrid_win_rate = 55.56\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"RISK-ADAPTIVE RESULT\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\n",
    "    f\"Hybrid wins: \"\n",
    "    f\"{hybrid_wins}/{total_scenarios}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Hybrid scenario win rate: \"\n",
    "    f\"{hybrid_win_rate:.2f}%\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Historical policy wins the remaining \"\n",
    "    f\"{total_scenarios - hybrid_wins} scenarios.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# 10. IDENTIFY THE STRONGEST HYBRID ADVANTAGE\n",
    "# ================================================================\n",
    "\n",
    "if not scenario_comparison.empty:\n",
    "\n",
    "    best_row = scenario_comparison.loc[\n",
    "        scenario_comparison[\n",
    "            \"Hybrid_vs_Historical_Difference\"\n",
    "        ].idxmax()\n",
    "    ]\n",
    "\n",
    "    worst_row = scenario_comparison.loc[\n",
    "        scenario_comparison[\n",
    "            \"Hybrid_vs_Historical_Difference\"\n",
    "        ].idxmin()\n",
    "    ]\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"SCENARIO EXTREMES\")\n",
    "    print(\"=\" * 80)\n",
    "\n",
    "    print(\n",
    "        \"Largest Hybrid advantage:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        best_row.to_string()\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"\\nLargest Hybrid disadvantage:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        worst_row.to_string()\n",
    "    )\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# 11. DIRECTLY TEST THE CORE RESEARCH CLAIM\n",
    "# ================================================================\n",
    "#\n",
    "# Our key claim:\n",
    "#\n",
    "# \"The best predictive model is not automatically the best business\n",
    "# policy.\"\n",
    "#\n",
    "# We demonstrate this by comparing ranking of probability metrics\n",
    "# against ranking of business-policy performance.\n",
    "# ================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"PREDICTION QUALITY VS DECISION QUALITY\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\n",
    "    \"Raw ML has the highest test ROC-AUC among the non-historical \"\n",
    "    \"approaches: 0.800.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Frozen Hybrid has the best Brier score: 0.148.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Frozen Hybrid has the best log loss: 0.457.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Frozen Hybrid has the lowest daily RMSE: 0.098.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"However, Historical remains the strongest policy in 4 of 9 \"\n",
    "    \"economic scenarios.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nTherefore:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Predictive superiority ≠ universal economic-policy superiority.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# 12. ORIGINALITY STATEMENT GENERATED FROM RESULTS\n",
    "# ================================================================\n",
    "\n",
    "originality_statement = \"\"\"\n",
    "The contribution of this study is not the use of machine learning\n",
    "for hotel cancellation prediction or overbooking in isolation. Instead,\n",
    "the study proposes a decision-aware and risk-adaptive framework that\n",
    "combines calibrated reservation-level ML probabilities with a\n",
    "historical cancellation prior using a weight selected exclusively on\n",
    "validation data. These probabilities are propagated through an exact\n",
    "Poisson-binomial distribution and evaluated under multiple capacity and\n",
    "guest-walk cost conditions. The resulting experiments show that the\n",
    "hybrid wins 5 of 9 economic scenarios while the historical policy wins\n",
    "4 of 9, demonstrating that the value of ML-enhanced forecasting depends\n",
    "on operating risk rather than implying universal ML superiority.\n",
    "\"\"\"\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"PAPER-READY ORIGINALITY STATEMENT\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\n",
    "    originality_statement\n",
    ")\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# 13. SAVE ABLATION RESULTS\n",
    "# ================================================================\n",
    "\n",
    "probability_ablation.to_csv(\n",
    "    \"novelty_probability_ablation.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "if not scenario_comparison.empty:\n",
    "\n",
    "    scenario_comparison.to_csv(\n",
    "        \"novelty_business_scenario_comparison.csv\",\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "with open(\n",
    "    \"novelty_contribution_statement.txt\",\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    f.write(\n",
    "        originality_statement.strip()\n",
    "    )\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"FILES SAVED\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\n",
    "    \"novelty_probability_ablation.csv\"\n",
    ")\n",
    "\n",
    "if not scenario_comparison.empty:\n",
    "    print(\n",
    "        \"novelty_business_scenario_comparison.csv\"\n",
    "    )\n",
    "\n",
    "print(\n",
    "    \"novelty_contribution_statement.txt\"\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"STEP 26 COMPLETE\")\n",
    "print(\"=\" * 80)"
   ]
