    "\n",
    "            oracle_daily_records.append({\n",
    "                \"arrival_date\": arrival_date,\n",
    "                \"policy\": \"Oracle\",\n",
    "                \"capacity\": capacity,\n",
    "                \"walk_cost\": walk_cost,\n",
    "                \"demand\": len(day_df),\n",
    "                \"accepted\": accepted_count,\n",
    "                \"actual_shows\": actual_show_count,\n",
    "                \"walks\": actual_walks,\n",
    "                \"empty_rooms\": actual_empty,\n",
    "                \"revenue\": revenue,\n",
    "                \"walk_cost_total\": walk_cost_total,\n",
    "                \"profit\": profit\n",
    "            })\n",
    "\n",
    "        oracle_summary = {\n",
    "            \"policy\": \"Oracle\",\n",
    "            \"capacity\": capacity,\n",
    "            \"walk_cost\": walk_cost,\n",
    "            \"accepted\": oracle_accepted,\n",
    "            \"actual_shows\": oracle_shows,\n",
    "            \"walks\": oracle_walks,\n",
    "            \"empty_rooms\": oracle_empty,\n",
    "            \"revenue\": oracle_revenue,\n",
    "            \"walk_cost_total\": oracle_walk_cost_total,\n",
    "            \"profit\": oracle_profit,\n",
    "            \"profit_per_day\": (\n",
    "                oracle_profit /\n",
    "                len(daily_bookings)\n",
    "            )\n",
    "        }\n",
    "\n",
    "        all_results.append(\n",
    "            oracle_summary\n",
    "        )\n",
    "\n",
    "        all_daily_records.append(\n",
    "            pd.DataFrame(\n",
    "                oracle_daily_records\n",
    "            )\n",
    "        )\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 11. COMBINE RESULTS\n",
    "# ------------------------------------------------\n",
    "\n",
    "hybrid_policy_results = pd.DataFrame(\n",
    "    all_results\n",
    ")\n",
    "\n",
    "hybrid_policy_daily = pd.concat(\n",
    "    all_daily_records,\n",
    "    ignore_index=True\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 12. ADD UPLIFT VS NO OVERBOOKING\n",
    "# ------------------------------------------------\n",
    "\n",
    "baseline_profit = (\n",
    "    hybrid_policy_results[\n",
    "        hybrid_policy_results[\"policy\"] ==\n",
    "        \"No Overbooking\"\n",
    "    ][\n",
    "        [\n",
    "            \"capacity\",\n",
    "            \"walk_cost\",\n",
    "            \"profit\"\n",
    "        ]\n",
    "    ]\n",
    "    .rename(\n",
    "        columns={\n",
    "            \"profit\":\n",
    "                \"no_overbooking_profit\"\n",
    "        }\n",
    "    )\n",
    ")\n",
    "\n",
    "hybrid_policy_results = (\n",
    "    hybrid_policy_results\n",
    "    .merge(\n",
    "        baseline_profit,\n",
    "        on=[\n",
    "            \"capacity\",\n",
    "            \"walk_cost\"\n",
    "        ],\n",
    "        how=\"left\"\n",
    "    )\n",
    ")\n",
    "\n",
    "hybrid_policy_results[\n",
    "    \"profit_uplift_vs_no_overbooking_pct\"\n",
    "] = (\n",
    "    (\n",
    "        hybrid_policy_results[\"profit\"] -\n",
    "        hybrid_policy_results[\n",
    "            \"no_overbooking_profit\"\n",
    "        ]\n",
    "    )\n",
    "    /\n",
    "    hybrid_policy_results[\n",
    "        \"no_overbooking_profit\"\n",
    "    ]\n",
    "    * 100\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 13. WINNER BY SCENARIO\n",
    "# ------------------------------------------------\n",
    "\n",
    "deployable_policies = [\n",
    "    \"No Overbooking\",\n",
    "    \"Expected Shows\",\n",
    "    \"Historical Newsvendor\",\n",
    "    \"Raw ML Newsvendor\",\n",
    "    \"Calibrated ML Newsvendor\",\n",
    "    \"Frozen Hybrid Newsvendor\"\n",
    "]\n",
    "\n",
    "deployable_results = (\n",
    "    hybrid_policy_results[\n",
    "        hybrid_policy_results[\"policy\"].isin(\n",
    "            deployable_policies\n",
    "        )\n",
    "    ]\n",
    ")\n",
    "\n",
    "winner_rows = []\n",
    "\n",
    "for (\n",
    "    capacity,\n",
    "    walk_cost\n",
    "), scenario_df in (\n",
    "    deployable_results\n",
    "    .groupby(\n",
    "        [\n",
    "            \"capacity\",\n",
    "            \"walk_cost\"\n",
    "        ]\n",
    "    )\n",
    "):\n",
    "\n",
    "    best_row = scenario_df.loc[\n",
    "        scenario_df[\"profit\"].idxmax()\n",
    "    ]\n",
    "\n",
    "    winner_rows.append({\n",
    "        \"capacity\": capacity,\n",
    "        \"walk_cost\": walk_cost,\n",
    "        \"winning_policy\": best_row[\"policy\"],\n",
    "        \"winning_profit\": best_row[\"profit\"]\n",
    "    })\n",
    "\n",
    "scenario_winners = pd.DataFrame(\n",
    "    winner_rows\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 14. POLICY WIN COUNTS\n",
    "# ------------------------------------------------\n",
    "\n",
    "policy_win_counts = (\n",
    "    scenario_winners[\n",
    "        \"winning_policy\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .rename_axis(\"policy\")\n",
    "    .reset_index(\n",
    "        name=\"scenario_wins\"\n",
    "    )\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 15. DISPLAY MAIN RESULTS\n",
    "# ------------------------------------------------\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"FROZEN HYBRID BUSINESS-POLICY RESULTS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "display_columns = [\n",
    "    \"policy\",\n",
    "    \"capacity\",\n",
    "    \"walk_cost\",\n",
    "    \"accepted\",\n",
    "    \"walks\",\n",
    "    \"empty_rooms\",\n",
    "    \"profit\",\n",
    "    \"profit_per_day\",\n",
    "    \"profit_uplift_vs_no_overbooking_pct\"\n",
    "]\n",
    "\n",
    "print(\n",
    "    hybrid_policy_results[\n",
    "        display_columns\n",
    "    ]\n",
    "    .round(2)\n",
    "    .to_string(index=False)\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 16. DISPLAY SCENARIO WINNERS\n",
    "# ------------------------------------------------\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"DEPLOYABLE POLICY WINNERS BY SCENARIO\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    scenario_winners\n",
    "    .round(2)\n",
    "    .to_string(index=False)\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 17. DISPLAY WIN COUNTS\n",
    "# ------------------------------------------------\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"POLICY SCENARIO WIN COUNTS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    policy_win_counts\n",
    "    .to_string(index=False)\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 18. SAVE RESULTS\n",
    "# ------------------------------------------------\n",
    "\n",
    "hybrid_policy_results.to_csv(\n",
    "    \"final_hybrid_overbooking_policy_results.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "hybrid_policy_daily.to_csv(\n",
    "    \"final_hybrid_overbooking_daily_results.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "scenario_winners.to_csv(\n",
    "    \"final_hybrid_policy_scenario_winners.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "policy_win_counts.to_csv(\n",
    "    \"final_hybrid_policy_win_counts.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"FILES SAVED\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    \"final_hybrid_overbooking_policy_results.csv\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"final_hybrid_overbooking_daily_results.csv\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"final_hybrid_policy_scenario_winners.csv\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"final_hybrid_policy_win_counts.csv\"\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"STEP 18 COMPLETE\")\n",
    "print(\"=\" * 70)"
   ]
