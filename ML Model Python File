    "# ================================================================\n",
    "# STEP 14 — FULL CAPACITY × WALK-COST SENSITIVITY ANALYSIS\n",
    "# ================================================================\n",
    "# Purpose:\n",
    "#   Evaluate whether the policy ranking is robust to different\n",
    "#   assumptions about hotel capacity and the cost of walking guests.\n",
    "#\n",
    "# Capacity scenarios:\n",
    "#   18, 34, 53 rooms\n",
    "#\n",
    "# Walk-cost scenarios:\n",
    "#   1x ADR, 2x ADR, 3x ADR\n",
    "#\n",
    "# Policies:\n",
    "#   1. No Overbooking\n",
    "#   2. Naive Historical\n",
    "#   3. Expected Shows\n",
    "#   4. Raw Newsvendor\n",
    "#   5. Calibrated Newsvendor\n",
    "#   6. Oracle\n",
    "#\n",
    "# IMPORTANT:\n",
    "#   Capacity and economics are estimated from TRAINING data.\n",
    "#   The TEST period is used only to evaluate realized outcomes.\n",
    "# ================================================================\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"STEP 14 — FULL SENSITIVITY ANALYSIS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 1. REUSE TEST BOOKING STREAM\n",
    "# ------------------------------------------------\n",
    "# policy_df was created in Step 13 and contains only\n",
    "# non-zero-night test bookings with valid booking dates.\n",
    "\n",
    "print(\"\\nTest bookings:\", len(policy_df))\n",
    "print(\"Test arrival days:\", policy_df[\"arrival_date_full\"].nunique())\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 2. DEFINE POLICIES\n",
    "# ------------------------------------------------\n",
    "policies = [\n",
    "    \"No Overbooking\",\n",
    "    \"Naive Historical\",\n",
    "    \"Expected Shows\",\n",
    "    \"Raw Newsvendor\",\n",
    "    \"Calibrated Newsvendor\",\n",
    "    \"Oracle\"\n",
    "]\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 3. RUN ALL 9 ECONOMIC SCENARIOS\n",
    "# ------------------------------------------------\n",
    "sensitivity_results = []\n",
    "\n",
    "for capacity_name, capacity in capacity_scenarios.items():\n",
    "\n",
    "    for walk_name, walk_cost in walk_cost_scenarios.items():\n",
    "\n",
    "        print(\n",
    "            f\"\\nRunning: {capacity_name} | {walk_name}\"\n",
    "        )\n",
    "\n",
    "        scenario_daily_results = []\n",
    "\n",
    "        for policy_name in policies:\n",
    "\n",
    "            for arrival_date, day_df in policy_df.groupby(\n",
    "                \"arrival_date_full\",\n",
    "                sort=True\n",
    "            ):\n",
    "\n",
    "                result = simulate_day(\n",
    "                    day_df=day_df,\n",
    "                    policy_name=policy_name,\n",
    "                    capacity=capacity,\n",
    "                    revenue=revenue_per_show,\n",
    "                    walk_cost=walk_cost,\n",
    "                    naive_show_probability=training_show_probability\n",
    "                )\n",
    "\n",
    "                scenario_daily_results.append(result)\n",
    "\n",
    "        scenario_df = pd.DataFrame(\n",
    "            scenario_daily_results\n",
    "        )\n",
    "\n",
    "\n",
    "        # ------------------------------------------------\n",
    "        # 4. SUMMARIZE EACH POLICY IN THIS SCENARIO\n",
    "        # ------------------------------------------------\n",
    "        summary = (\n",
    "            scenario_df\n",
    "            .groupby(\"policy\")\n",
    "            .agg(\n",
    "                total_demand=(\"demand_bookings\", \"sum\"),\n",
    "                total_accepted=(\"accepted_bookings\", \"sum\"),\n",
    "                total_shows=(\"actual_shows\", \"sum\"),\n",
    "                total_walks=(\"actual_walks\", \"sum\"),\n",
    "                total_empty_rooms=(\"actual_empty_rooms\", \"sum\"),\n",
    "                total_revenue=(\"actual_revenue\", \"sum\"),\n",
    "                total_walk_cost=(\"actual_walk_cost\", \"sum\"),\n",
    "                total_profit=(\"actual_profit\", \"sum\"),\n",
    "                mean_profit_per_day=(\"actual_profit\", \"mean\"),\n",
    "                mean_walks_per_day=(\"actual_walks\", \"mean\"),\n",
    "                mean_empty_rooms_per_day=(\"actual_empty_rooms\", \"mean\")\n",
    "            )\n",
    "            .reset_index()\n",
    "        )\n",
    "\n",
    "\n",
    "        # ------------------------------------------------\n",
    "        # 5. ADD SCENARIO IDENTIFIERS\n",
    "        # ------------------------------------------------\n",
    "        summary[\"capacity_scenario\"] = capacity_name\n",
    "        summary[\"capacity\"] = capacity\n",
    "\n",
    "        summary[\"walk_cost_scenario\"] = walk_name\n",
    "        summary[\"walk_cost\"] = walk_cost\n",
    "\n",
    "        summary[\"walk_rate_per_accepted\"] = (\n",
    "            summary[\"total_walks\"] /\n",
    "            summary[\"total_accepted\"].replace(0, np.nan)\n",
    "        )\n",
    "\n",
    "\n",
    "        # ------------------------------------------------\n",
    "        # 6. PROFIT RELATIVE TO NO-OVERBOOKING\n",
    "        # ------------------------------------------------\n",
    "        no_overbooking_profit = (\n",
    "            summary.loc[\n",
    "                summary[\"policy\"] == \"No Overbooking\",\n",
    "                \"total_profit\"\n",
    "            ].iloc[0]\n",
    "        )\n",
    "\n",
    "        summary[\"profit_uplift_vs_no_overbooking\"] = (\n",
    "            (\n",
    "                summary[\"total_profit\"] -\n",
    "                no_overbooking_profit\n",
    "            )\n",
    "            /\n",
    "            no_overbooking_profit\n",
    "        )\n",
    "\n",
    "\n",
    "        sensitivity_results.append(\n",
    "            summary\n",
    "        )\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 7. COMBINE ALL SCENARIOS\n",
    "# ------------------------------------------------\n",
    "sensitivity_df = pd.concat(\n",
    "    sensitivity_results,\n",
    "    ignore_index=True\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 8. IDENTIFY BEST DEPLOYABLE POLICY\n",
    "# ------------------------------------------------\n",
    "# Oracle is excluded because it has access to actual outcomes.\n",
    "deployable_policies = [\n",
    "    \"No Overbooking\",\n",
    "    \"Naive Historical\",\n",
    "    \"Expected Shows\",\n",
    "    \"Raw Newsvendor\",\n",
    "    \"Calibrated Newsvendor\"\n",
    "]\n",
    "\n",
    "deployable_df = sensitivity_df[\n",
    "    sensitivity_df[\"policy\"].isin(\n",
    "        deployable_policies\n",
    "    )\n",
    "].copy()\n",
    "\n",
    "\n",
    "best_policy_by_scenario = (\n",
    "    deployable_df\n",
    "    .sort_values(\n",
    "        [\n",
    "            \"capacity\",\n",
    "            \"walk_cost\",\n",
    "            \"total_profit\"\n",
    "        ],\n",
    "        ascending=[\n",
    "            True,\n",
    "            True,\n",
    "            False\n",
    "        ]\n",
    "    )\n",
    "    .groupby(\n",
    "        [\n",
    "            \"capacity\",\n",
    "            \"walk_cost\"\n",
    "        ],\n",
    "        as_index=False\n",
    "    )\n",
    "    .first()\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 9. DISPLAY COMPLETE RESULTS\n",
    "# ------------------------------------------------\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"FULL POLICY SENSITIVITY RESULTS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "display_columns = [\n",
    "    \"capacity\",\n",
    "    \"walk_cost\",\n",
    "    \"policy\",\n",
    "    \"total_profit\",\n",
    "    \"mean_profit_per_day\",\n",
    "    \"total_walks\",\n",
    "    \"mean_walks_per_day\",\n",
    "    \"total_empty_rooms\",\n",
    "    \"mean_empty_rooms_per_day\",\n",
    "    \"walk_rate_per_accepted\",\n",
    "    \"profit_uplift_vs_no_overbooking\"\n",
    "]\n",
    "\n",
    "print(\n",
    "    sensitivity_df[\n",
    "        display_columns\n",
    "    ]\n",
    "    .sort_values(\n",
    "        [\"capacity\", \"walk_cost\", \"total_profit\"],\n",
    "        ascending=[True, True, False]\n",
    "    )\n",
    "    .round(4)\n",
    "    .to_string(index=False)\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
