    "        )\n",
    "\n",
    "        all_results.append(\n",
    "            expected_summary\n",
    "        )\n",
    "\n",
    "        all_daily_records.append(\n",
    "            expected_daily\n",
    "        )\n",
    "\n",
    "        # -----------------------------\n",
    "        # ML / Historical Newsvendor\n",
