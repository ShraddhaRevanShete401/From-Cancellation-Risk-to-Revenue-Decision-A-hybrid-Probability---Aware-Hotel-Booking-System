    "# ================================================================\n",
    "# STEP 11 — EXACT POISSON-BINOMIAL PROFIT ENGINE\n",
    "# ================================================================\n",
    "# Purpose:\n",
    "#   For a given set of accepted bookings, calculate the exact\n",
    "#   distribution of show-ups using the Poisson-binomial distribution.\n",
    "#\n",
    "#   We then calculate:\n",
    "#       Expected shows\n",
    "#       Probability of exceeding capacity\n",
    "#       Expected empty rooms\n",
    "#       Expected walked guests\n",
    "#       Expected revenue\n",
    "#       Expected walk cost\n",
    "#       Expected net profit\n",
    "#\n",
    "#   This is the mathematical engine that will power the\n",
    "#   overbooking decision policies in the next step.\n",
    "# ================================================================\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"STEP 11 — EXACT POISSON-BINOMIAL PROFIT ENGINE\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 1. POISSON-BINOMIAL PMF\n",
    "# ------------------------------------------------\n",
    "def poisson_binomial_pmf(probabilities):\n",
    "    \"\"\"\n",
    "    Calculate the exact Poisson-binomial probability mass function.\n",
    "\n",
    "    probabilities:\n",
    "        List/array of individual booking show probabilities.\n",
    "\n",
    "    Returns:\n",
    "        pmf[k] = P(S = k)\n",
    "        where S is the total number of show-ups.\n",
    "    \"\"\"\n",
    "\n",
    "    probabilities = np.asarray(probabilities, dtype=float)\n",
    "\n",
    "    # Remove invalid values defensively\n",
    "    probabilities = probabilities[np.isfinite(probabilities)]\n",
    "\n",
    "    if len(probabilities) == 0:\n",
    "        return np.array([1.0])\n",
    "\n",
    "    # Keep probabilities numerically inside [0, 1]\n",
    "    probabilities = np.clip(probabilities, 0.0, 1.0)\n",
    "\n",
    "    # pmf initially represents zero bookings:\n",
    "    # P(S=0)=1\n",
    "    pmf = np.array([1.0])\n",
    "\n",
    "    # Sequentially convolve each Bernoulli distribution\n",
    "    for p in probabilities:\n",
    "\n",
    "        # New distribution after adding one booking\n",
    "        new_pmf = np.zeros(len(pmf) + 1)\n",
    "\n",
    "        # Existing number of shows stays the same\n",
    "        new_pmf[:-1] += pmf * (1.0 - p)\n",
    "\n",
    "        # One additional show occurs\n",
    "        new_pmf[1:] += pmf * p\n",
    "\n",
    "        pmf = new_pmf\n",
    "\n",
    "    # Numerical normalization\n",
    "    pmf = pmf / pmf.sum()\n",
    "\n",
    "    return pmf\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 2. EXPECTED BUSINESS OUTCOMES\n",
    "# ------------------------------------------------\n",
    "def calculate_expected_profit(probabilities, capacity, revenue_per_show,\n",
    "                              walk_cost_per_guest):\n",
    "    \"\"\"\n",
    "    Calculate exact expected overbooking economics.\n",
    "\n",
    "    Profit:\n",
    "        revenue_per_show * min(S, capacity)\n",
    "        -\n",
    "        walk_cost_per_guest * max(0, S-capacity)\n",
    "\n",
    "    Returns a dictionary of business metrics.\n",
    "    \"\"\"\n",
    "\n",
    "    probabilities = np.asarray(probabilities, dtype=float)\n",
    "    probabilities = np.clip(probabilities, 0.0, 1.0)\n",
    "\n",
    "    n_bookings = len(probabilities)\n",
    "\n",
    "    # Empty candidate set\n",
    "    if n_bookings == 0:\n",
    "        return {\n",
    "            \"accepted_bookings\": 0,\n",
    "            \"expected_shows\": 0.0,\n",
    "            \"probability_over_capacity\": 0.0,\n",
    "            \"expected_empty_rooms\": float(capacity),\n",
    "            \"expected_walks\": 0.0,\n",
    "            \"expected_revenue\": 0.0,\n",
    "            \"expected_walk_cost\": 0.0,\n",
    "            \"expected_profit\": 0.0\n",
    "        }\n",
    "\n",
    "    # Exact Poisson-binomial distribution\n",
    "    pmf = poisson_binomial_pmf(probabilities)\n",
    "\n",
    "    show_counts = np.arange(len(pmf))\n",
    "\n",
    "    # Expected number of shows\n",
    "    expected_shows = np.sum(show_counts * pmf)\n",
    "\n",
    "    # Probability that demand exceeds capacity\n",
    "    probability_over_capacity = np.sum(\n",
    "        pmf[capacity + 1:]\n",
    "    ) if capacity + 1 < len(pmf) else 0.0\n",
    "\n",
    "    # Number of rooms actually occupied\n",
    "    occupied_rooms = np.minimum(show_counts, capacity)\n",
    "\n",
    "    # Expected occupied rooms\n",
    "    expected_occupied_rooms = np.sum(\n",
    "        occupied_rooms * pmf\n",
    "    )\n",
    "\n",
    "    # Expected empty rooms\n",
    "    expected_empty_rooms = max(\n",
    "        0.0,\n",
    "        capacity - expected_occupied_rooms\n",
    "    )\n",
    "\n",
    "    # Expected walked guests\n",
    "    walked_guests = np.maximum(\n",
    "        show_counts - capacity,\n",
    "        0\n",
    "    )\n",
    "\n",
    "    expected_walks = np.sum(\n",
    "        walked_guests * pmf\n",
    "    )\n",
    "\n",
    "    # Expected revenue from occupied rooms\n",
    "    expected_revenue = (\n",
    "        revenue_per_show *\n",
    "        expected_occupied_rooms\n",
    "    )\n",
    "\n",
    "    # Expected cost of walking guests\n",
    "    expected_walk_cost = (\n",
    "        walk_cost_per_guest *\n",
    "        expected_walks\n",
    "    )\n",
    "\n",
    "    # Expected net profit\n",
    "    expected_profit = (\n",
    "        expected_revenue -\n",
    "        expected_walk_cost\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        \"accepted_bookings\": n_bookings,\n",
    "        \"expected_shows\": expected_shows,\n",
    "        \"probability_over_capacity\": probability_over_capacity,\n",
    "        \"expected_empty_rooms\": expected_empty_rooms,\n",
    "        \"expected_walks\": expected_walks,\n",
    "        \"expected_revenue\": expected_revenue,\n",
    "        \"expected_walk_cost\": expected_walk_cost,\n",
    "        \"expected_profit\": expected_profit\n",
    "    }\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 3. SANITY CHECK — SIMPLE KNOWN CASE\n",
    "# ------------------------------------------------\n",
    "# Three bookings, each with 50% probability of showing.\n",
    "#\n",
    "# The exact distribution should be:\n",
    "#   P(S=0) = 0.125\n",
    "#   P(S=1) = 0.375\n",
    "#   P(S=2) = 0.375\n",
    "#   P(S=3) = 0.125\n",
    "#\n",
    "# This verifies that our Poisson-binomial implementation works.\n",
    "\n",
    "test_probabilities = np.array([0.5, 0.5, 0.5])\n",
    "\n",
    "test_pmf = poisson_binomial_pmf(test_probabilities)\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"POISSON-BINOMIAL SANITY CHECK\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\"Probabilities:\", test_probabilities)\n",
    "print(\"Calculated PMF:\", np.round(test_pmf, 4))\n",
    "\n",
    "expected_pmf = np.array([\n",
    "    0.125,\n",
    "    0.375,\n",
    "    0.375,\n",
    "    0.125\n",
    "])\n",
    "\n",
    "pmf_error = np.max(\n",
    "    np.abs(test_pmf - expected_pmf)\n",
    ")\n",
    "\n",
    "print(\"Maximum PMF error:\", round(pmf_error, 10))\n",
    "\n",
    "if pmf_error < 1e-10:\n",
    "    print(\"STATUS: PASS\")\n",
    "else:\n",
    "    print(\"STATUS: CHECK IMPLEMENTATION\")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 4. TEST BUSINESS ECONOMICS\n",
    "# ------------------------------------------------\n",
    "# Example:\n",
    "#   5 accepted bookings\n",
    "#   each has 80% probability of showing\n",
    "#   hotel capacity = 4\n",
    "#   revenue = 100\n",
    "#   walk cost = 200\n",
    "\n",
    "example_result = calculate_expected_profit(\n",
    "    probabilities=np.array([0.8] * 5),\n",
    "    capacity=4,\n",
    "    revenue_per_show=100,\n",
    "    walk_cost_per_guest=200\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"BUSINESS ECONOMICS SANITY CHECK\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "for key, value in example_result.items():\n",
    "\n",
    "    if isinstance(value, (float, np.floating)):\n",
    "        print(f\"{key:30s}: {value:.4f}\")\n",
    "\n",
    "    else:\n",
    "        print(f\"{key:30s}: {value}\")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 5. VERIFY PROFIT CALCULATION\n",
    "# ------------------------------------------------\n",
    "# Profit should equal:\n",
    "#\n",
    "#   Expected revenue - Expected walk cost\n",
    "\n",
    "profit_check = (\n",
    "    example_result[\"expected_revenue\"]\n",
    "    -\n",
    "    example_result[\"expected_walk_cost\"]\n",
    ")\n",
    "\n",
    "print(\"\\nProfit calculation error:\",\n",
    "      round(\n",
    "          abs(\n",
    "              profit_check -\n",
    "              example_result[\"expected_profit\"]\n",
    "          ),\n",
    "          10\n",
    "      ))\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 6. SAVE ENGINE TEST OUTPUT\n",
    "# ------------------------------------------------\n",
    "engine_validation = pd.DataFrame([{\n",
    "    \"test\": \"Poisson-binomial PMF\",\n",
    "    \"maximum_pmf_error\": pmf_error,\n",
    "    \"status\": \"PASS\" if pmf_error < 1e-10 else \"CHECK\"\n",
    "}])\n",
    "\n",
    "engine_validation.to_csv(\n",
    "    \"poisson_binomial_engine_validation.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"FILES SAVED\")\n",
    "print(\"=\" * 70)\n",
    "print(\"poisson_binomial_engine_validation.csv\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"STEP 11 COMPLETE\")\n",
    "print(\"=\" * 70)"
