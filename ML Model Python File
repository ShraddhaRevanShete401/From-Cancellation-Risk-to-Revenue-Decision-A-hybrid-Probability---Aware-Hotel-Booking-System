    "# ================================================================\n",
    "# STEP 20 — FINAL PAPER FIGURES\n",
    "# ================================================================\n",
    "#\n",
    "# Creates the main publication-ready figures:\n",
    "#\n",
    "#   Figure 1: Probability-model Brier score comparison\n",
    "#   Figure 2: Profit comparison across capacity/walk-cost scenarios\n",
    "#   Figure 3: Winning policy decision map\n",
    "#\n",
    "# These figures use FINAL TEST / FINAL BUSINESS RESULTS only.\n",
    "# No model parameters are being tuned here.\n",
    "# ================================================================\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"STEP 20 — FINAL PAPER FIGURES\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 1. LOAD FINAL RESULTS\n",
    "# ------------------------------------------------\n",
    "\n",
    "probability_results = pd.read_csv(\n",
    "    \"final_test_probability_comparison.csv\"\n",
    ")\n",
    "\n",
    "policy_results = pd.read_csv(\n",
    "    \"final_hybrid_overbooking_policy_results.csv\"\n",
    ")\n",
    "\n",
    "scenario_winners = pd.read_csv(\n",
    "    \"final_hybrid_policy_scenario_winners.csv\"\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 2. FIGURE 1 — PROBABILITY PERFORMANCE\n",
    "# ------------------------------------------------\n",
    "\n",
    "probability_plot = probability_results.copy()\n",
    "\n",
    "# Shorter names for paper figure\n",
    "probability_plot[\"approach\"] = (\n",
    "    probability_plot[\"approach\"]\n",
    "    .replace({\n",
    "        \"Historical\": \"Historical\",\n",
    "        \"Raw ML\": \"Raw ML\",\n",
    "        \"Calibrated ML\": \"Calibrated ML\",\n",
    "        \"Frozen Hybrid\": \"Hybrid\"\n",
    "    })\n",
    ")\n",
    "\n",
    "fig, ax = plt.subplots(\n",
    "    figsize=(8, 5)\n",
    ")\n",
    "\n",
    "ax.bar(\n",
    "    probability_plot[\"approach\"],\n",
    "    probability_plot[\"brier_score\"]\n",
    ")\n",
    "\n",
    "ax.set_ylabel(\n",
    "    \"Brier Score (lower is better)\"\n",
    ")\n",
    "\n",
    "ax.set_title(\n",
    "    \"Cancellation Probability Performance on Test Set\"\n",
    ")\n",
    "\n",
    "ax.grid(\n",
    "    axis=\"y\",\n",
    "    alpha=0.25\n",
    ")\n",
    "\n",
    "plt.xticks(\n",
    "    rotation=15\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "fig.savefig(\n",
    "    \"figure_1_probability_performance.png\",\n",
    "    dpi=300,\n",
    "    bbox_inches=\"tight\"\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 3. FIGURE 2 — PROFIT BY SCENARIO\n",
    "# ------------------------------------------------\n",
    "\n",
    "selected_policies = [\n",
    "    \"No Overbooking\",\n",
    "    \"Historical Newsvendor\",\n",
    "    \"Frozen Hybrid Newsvendor\"\n",
    "]\n",
    "\n",
    "profit_plot = policy_results[\n",
    "    policy_results[\"policy\"].isin(\n",
    "        selected_policies\n",
    "    )\n",
    "].copy()\n",
    "\n",
    "profit_plot[\"scenario\"] = (\n",
    "    \"C=\" +\n",
    "    profit_plot[\"capacity\"].astype(int).astype(str) +\n",
    "    \", \" +\n",
    "    (\n",
    "        profit_plot[\"walk_cost\"] /\n",
    "        profit_plot[\"walk_cost\"].min()\n",
    "    ).round(0).astype(int).astype(str) +\n",
    "    \"x\"\n",
    ")\n",
    "\n",
    "scenario_order = [\n",
    "    \"C=18, 1x\",\n",
    "    \"C=18, 2x\",\n",
    "    \"C=18, 3x\",\n",
    "    \"C=34, 1x\",\n",
    "    \"C=34, 2x\",\n",
    "    \"C=34, 3x\",\n",
    "    \"C=53, 1x\",\n",
    "    \"C=53, 2x\",\n",
    "    \"C=53, 3x\"\n",
    "]\n",
    "\n",
    "profit_plot[\"scenario\"] = pd.Categorical(\n",
    "    profit_plot[\"scenario\"],\n",
    "    categories=scenario_order,\n",
    "    ordered=True\n",
    ")\n",
    "\n",
    "profit_plot = profit_plot.sort_values(\n",
    "    \"scenario\"\n",
    ")\n",
    "\n",
    "fig, ax = plt.subplots(\n",
    "    figsize=(11, 5.5)\n",
    ")\n",
    "\n",
    "for policy in selected_policies:\n",
    "\n",
    "    subset = profit_plot[\n",
    "        profit_plot[\"policy\"] == policy\n",
    "    ]\n",
    "\n",
    "    ax.plot(\n",
    "        subset[\"scenario\"],\n",
    "        subset[\"profit\"],\n",
    "        marker=\"o\",\n",
    "        linewidth=2,\n",
    "        label=policy\n",
    "    )\n",
    "\n",
    "ax.set_xlabel(\n",
    "    \"Capacity / Walk-Cost Scenario\"\n",
    ")\n",
    "\n",
    "ax.set_ylabel(\n",
    "    \"Test-Set Profit\"\n",
    ")\n",
    "\n",
    "ax.set_title(\n",
    "    \"Overbooking Profit Under Capacity and Walk-Cost Uncertainty\"\n",
    ")\n",
    "\n",
    "ax.grid(\n",
    "    axis=\"y\",\n",
    "    alpha=0.25\n",
    ")\n",
    "\n",
    "ax.legend()\n",
    "\n",
    "plt.xticks(\n",
    "    rotation=45,\n",
    "    ha=\"right\"\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "fig.savefig(\n",
    "    \"figure_2_profit_sensitivity.png\",\n",
    "    dpi=300,\n",
    "    bbox_inches=\"tight\"\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 4. FIGURE 3 — POLICY DECISION MAP\n",
    "# ------------------------------------------------\n",
    "\n",
