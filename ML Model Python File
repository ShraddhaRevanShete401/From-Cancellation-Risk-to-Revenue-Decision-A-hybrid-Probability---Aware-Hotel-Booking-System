    "# ================================================================\n",
    "# STEP 17 — FINAL TEST EVALUATION OF FROZEN HYBRID\n",
    "# ================================================================\n",
    "# Purpose:\n",
    "#   Evaluate the validation-selected hybrid on the untouched TEST\n",
    "#   set.\n",
    "#\n",
    "# The hybrid weight was selected on VALIDATION only:\n",
    "#\n",
    "#       alpha_ML = 0.55\n",
    "#       alpha_historical = 0.45\n",
    "#\n",
    "# NO parameter is selected using TEST performance.\n",
    "#\n",
    "# Models compared:\n",
    "#   1. Historical baseline\n",
    "#   2. Raw ML\n",
    "#   3. Calibrated ML\n",
    "#   4. Frozen validation-selected hybrid\n",
    "# ================================================================\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.metrics import (\n",
    "    roc_auc_score,\n",
    "    average_precision_score,\n",
    "    log_loss\n",
    ")\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"STEP 17 — FINAL TEST EVALUATION OF FROZEN HYBRID\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 1. PREPARE TEST TARGET\n",
    "# ------------------------------------------------\n",
    "test_actual_cancelled = (\n",
    "    test_df[\"target_cancelled\"].to_numpy()\n",
    ")\n",
    "\n",
    "print(\"\\nTest target rows:\",\n",
    "      len(test_actual_cancelled))\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 2. USE THE FROZEN VALIDATION-SELECTED WEIGHT\n",
    "# ------------------------------------------------\n",
    "# IMPORTANT:\n",
    "# Do not optimize this value here.\n",
    "\n",
    "frozen_alpha_ml = float(\n",
    "    selected_alpha\n",
    ")\n",
    "\n",
    "frozen_alpha_historical = float(\n",
    "    selected_historical_weight\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Frozen ML weight: \"\n",
    "    f\"{frozen_alpha_ml:.2f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Frozen historical weight: \"\n",
    "    f\"{frozen_alpha_historical:.2f}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 3. TEST RAW ML PROBABILITIES\n",
    "# ------------------------------------------------\n",
    "# These should already exist from the previous test\n",
    "# calibration steps. We regenerate them to make this\n",
    "# step self-contained.\n",
    "\n",
    "test_raw_cancel_probability = (\n",
    "    best_model.predict_proba(\n",
    "        X_test\n",
    "    )[:, 1]\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 4. TEST CALIBRATED ML PROBABILITIES\n",
    "# ------------------------------------------------\n",
    "test_calibrated_cancel_probability = (\n",
    "    isotonic_calibrator.predict(\n",
    "        test_raw_cancel_probability\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 5. TEST HISTORICAL BASELINE\n",
    "# ------------------------------------------------\n",
    "historical_cancel_probability = (\n",
    "    train_df[\"target_cancelled\"].mean()\n",
    ")\n",
    "\n",
    "test_historical_probability = np.repeat(\n",
    "    historical_cancel_probability,\n",
    "    len(test_actual_cancelled)\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 6. CREATE FROZEN HYBRID\n",
    "# ------------------------------------------------\n",
    "test_hybrid_cancel_probability = (\n",
    "    frozen_alpha_ml *\n",
    "    test_calibrated_cancel_probability\n",
    "    +\n",
    "    frozen_alpha_historical *\n",
    "    test_historical_probability\n",
    ")\n",
    "\n",
    "test_hybrid_cancel_probability = np.clip(\n",
    "    test_hybrid_cancel_probability,\n",
    "    0.0,\n",
    "    1.0\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 7. PROBABILITY ALIGNMENT CHECK\n",
    "# ------------------------------------------------\n",
    "probability_arrays = {\n",
    "    \"Historical\":\n",
    "        test_historical_probability,\n",
    "\n",
    "    \"Raw ML\":\n",
    "        test_raw_cancel_probability,\n",
    "\n",
    "    \"Calibrated ML\":\n",
    "        test_calibrated_cancel_probability,\n",
    "\n",
    "    \"Frozen Hybrid\":\n",
    "        test_hybrid_cancel_probability\n",
    "}\n",
    "\n",
    "for name, probabilities in probability_arrays.items():\n",
    "\n",
    "    if len(probabilities) != len(\n",
    "        test_actual_cancelled\n",
    "    ):\n",
    "        raise ValueError(\n",
    "            f\"{name} probability length does not \"\n",
    "            f\"match test target length.\"\n",
    "        )\n",
    "\n",
    "    if np.any(probabilities < 0) or np.any(\n",
    "        probabilities > 1\n",
    "    ):\n",
    "        raise ValueError(\n",
    "            f\"{name} contains probabilities outside [0,1].\"\n",
    "        )\n",
    "\n",
    "print(\n",
    "    \"STATUS: ALL TEST PROBABILITY ARRAYS ALIGNED\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 8. ECE FUNCTION\n",
    "# ------------------------------------------------\n",
    "def calculate_ece(\n",
    "    probabilities,\n",
    "    actual,\n",
    "    n_bins=10\n",
    "):\n",
    "    \"\"\"\n",
    "    Expected Calibration Error using equal-width\n",
    "    probability bins.\n",
    "    \"\"\"\n",
    "\n",
    "    probabilities = np.asarray(\n",
    "        probabilities\n",
    "    )\n",
    "\n",
    "    actual = np.asarray(\n",
    "        actual\n",
    "    )\n",
    "\n",
    "    bin_edges = np.linspace(\n",
    "        0,\n",
    "        1,\n",
    "        n_bins + 1\n",
    "    )\n",
    "\n",
    "    ece = 0.0\n",
    "\n",
    "    for i in range(n_bins):\n",
    "\n",
    "        lower = bin_edges[i]\n",
    "        upper = bin_edges[i + 1]\n",
    "\n",
    "        if i == n_bins - 1:\n",
    "\n",
    "            mask = (\n",
    "                (probabilities >= lower)\n",
    "                &\n",
    "                (probabilities <= upper)\n",
    "            )\n",
    "\n",
    "        else:\n",
    "\n",
    "            mask = (\n",
    "                (probabilities >= lower)\n",
    "                &\n",
    "                (probabilities < upper)\n",
    "            )\n",
    "\n",
    "        count = mask.sum()\n",
    "\n",
    "        if count == 0:\n",
    "            continue\n",
    "\n",
    "        mean_probability = (\n",
    "            probabilities[mask].mean()\n",
    "        )\n",
    "\n",
    "        observed_rate = (\n",
    "            actual[mask].mean()\n",
    "        )\n",
    "\n",
    "        ece += (\n",
    "            count /\n",
    "            len(probabilities)\n",
    "        ) * abs(\n",
    "            mean_probability -\n",
    "            observed_rate\n",
    "        )\n",
    "\n",
    "    return ece\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 9. EVALUATE ALL APPROACHES\n",
    "# ------------------------------------------------\n",
    "test_probability_results = []\n",
    "\n",
    "for approach, probabilities in probability_arrays.items():\n",
    "\n",
    "    brier_score = np.mean(\n",
    "        (\n",
    "            probabilities -\n",
    "            test_actual_cancelled\n",
    "        ) ** 2\n",
    "    )\n",
    "\n",
    "    test_log_loss = log_loss(\n",
    "        test_actual_cancelled,\n",
    "        probabilities,\n",
    "        labels=[0, 1]\n",
    "    )\n",
    "\n",
    "    ece = calculate_ece(\n",
    "        probabilities,\n",
    "        test_actual_cancelled\n",
    "    )\n",
    "\n",
    "    roc_auc = roc_auc_score(\n",
    "        test_actual_cancelled,\n",
    "        probabilities\n",
    "    )\n",
    "\n",
    "    pr_auc = average_precision_score(\n",
    "        test_actual_cancelled,\n",
    "        probabilities\n",
    "    )\n",
    "\n",
    "    mean_probability = (\n",
    "        probabilities.mean()\n",
    "    )\n",
    "\n",
    "    actual_rate = (\n",
    "        test_actual_cancelled.mean()\n",
    "    )\n",
    "\n",
    "    bias = (\n",
    "        mean_probability -\n",
    "        actual_rate\n",
    "    )\n",
    "\n",
    "    test_probability_results.append({\n",
    "        \"approach\": approach,\n",
    "        \"mean_cancel_probability\":\n",
    "            mean_probability,\n",
    "        \"actual_test_cancel_rate\":\n",
    "            actual_rate,\n",
    "        \"bias\":\n",
    "            bias,\n",
    "        \"absolute_bias\":\n",
    "            abs(bias),\n",
    "        \"brier_score\":\n",
    "            brier_score,\n",
    "        \"log_loss\":\n",
    "            test_log_loss,\n",
    "        \"ECE\":\n",
    "            ece,\n",
    "        \"ROC_AUC\":\n",
    "            roc_auc,\n",
    "        \"PR_AUC\":\n",
    "            pr_auc\n",
    "    })\n",
    "\n",
    "\n",
    "test_probability_results_df = pd.DataFrame(\n",
    "    test_probability_results\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 10. DAILY FORECAST ERROR\n",
    "# ------------------------------------------------\n",
    "test_diagnostic_df = test_df.copy()\n",
