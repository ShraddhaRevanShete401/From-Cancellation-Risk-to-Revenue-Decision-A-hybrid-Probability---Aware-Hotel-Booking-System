    "\n",
    "hybrid_probabilities_df = pd.read_csv(\n",
    "    \"final_test_hybrid_probabilities.csv\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nFrozen probability rows:\",\n",
    "    len(hybrid_probabilities_df)\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 2. PREPARE TEST DATA\n",
