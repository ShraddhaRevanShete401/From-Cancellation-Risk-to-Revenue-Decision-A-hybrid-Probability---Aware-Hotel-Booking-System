    "    for column in probability_columns:\n",
    "\n",
    "        minimum = final_probs[column].min()\n",
    "        maximum = final_probs[column].max()\n",
    "\n",
    "        valid = (\n",
    "            minimum >= 0\n",
    "            and\n",
    "            maximum <= 1\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            f\"{column}: \"\n",
    "            f\"min={minimum:.4f}, \"\n",
    "            f\"max={maximum:.4f}, \"\n",
    "            f\"valid={valid}\"\n",
    "        )\n",
    "\n",
    "        probability_range_ok = (\n",
    "            probability_range_ok\n",
    "            and\n",
    "            valid\n",
    "        )\n",
    "\n",
    "print(\n",
    "    \"All probabilities in [0,1]:\",\n",
    "    probability_range_ok\n",
    ")\n",
    "\n",
    "audit_results.append({\n",
    "    \"check\": \"All final probabilities lie in [0,1]\",\n",
    "    \"status\": probability_range_ok\n",
    "})\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 6. POLICY SCENARIO COVERAGE\n",
    "# ------------------------------------------------\n",
    "\n",
    "policy_results = pd.read_csv(\n",
    "    \"final_hybrid_overbooking_policy_results.csv\"\n",
    ")\n",
    "\n",
    "scenario_winners = pd.read_csv(\n",
    "    \"final_hybrid_policy_scenario_winners.csv\"\n",
    ")\n",
    "\n",
    "expected_capacities = {\n",
    "    18,\n",
    "    34,\n",
    "    53\n",
    "}\n",
    "\n",
    "actual_capacities = set(\n",
    "    policy_results[\"capacity\"].unique()\n",
    ")\n",
    "\n",
    "expected_walk_multipliers = {\n",
    "    1,\n",
    "    2,\n",
    "    3\n",
    "}\n",
    "\n",
    "minimum_walk_cost = (\n",
    "    policy_results[\n",
    "        policy_results[\"walk_cost\"] > 0\n",
    "    ][\"walk_cost\"].min()\n",
