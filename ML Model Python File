    "\n",
    "# Group customers according to whether they have\n",
    "# previous cancellation history.\n",
    "\n",
    "df_clean[\"previous_cancel_group\"] = np.where(\n",
    "    df_clean[\"no_of_previous_cancellations\"] == 0,\n",
    "    \"No Previous Cancellations\",\n",
    "    \"Has Previous Cancellations\"\n",
    ")\n",
    "\n",
    "previous_cancel_analysis = (\n",
    "    df_clean\n",
    "    .groupby(\"previous_cancel_group\")[\"target_cancelled\"]\n",
    "    .agg([\"count\", \"mean\"])\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "previous_cancel_analysis[\"cancellation_rate_%\"] = (\n",
    "    previous_cancel_analysis[\"mean\"] * 100\n",
    ")\n",
    "\n",
    "print(previous_cancel_analysis)\n",
    "\n",
    "\n",
    "plt.figure(figsize=(9, 5))\n",
    "\n",
    "sns.barplot(\n",
    "    data=previous_cancel_analysis,\n",
    "    x=\"previous_cancel_group\",\n",
    "    y=\"cancellation_rate_%\"\n",
    ")\n",
    "\n",
    "plt.title(\"Current Cancellation Rate by Previous Cancellation History\")\n",
    "plt.xlabel(\"Previous Cancellation History\")\n",
    "plt.ylabel(\"Current Cancellation Rate (%)\")\n",
    "\n",
    "plt.xticks(rotation=15)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. CANCELLATION RATE BY TOTAL NIGHTS\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"10. CANCELLATION RATE BY TOTAL NIGHTS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "# Instead of creating one group for every possible number\n",
    "# of nights, group them into useful business categories.\n",
    "\n",
    "night_bins = [\n",
    "    -1,\n",
    "    1,\n",
    "    3,\n",
    "    5,\n",
    "    7,\n",
    "    14,\n",
    "    np.inf\n",
    "]\n",
    "\n",
    "night_labels = [\n",
    "    \"0-1\",\n",
    "    \"2-3\",\n",
    "    \"4-5\",\n",
    "    \"6-7\",\n",
    "    \"8-14\",\n",
    "    \"15+\"\n",
    "]\n",
    "\n",
    "df_clean[\"stay_length_group\"] = pd.cut(\n",
    "    df_clean[\"total_nights\"],\n",
    "    bins=night_bins,\n",
    "    labels=night_labels\n",
    ")\n",
    "\n",
    "stay_analysis = (\n",
    "    df_clean\n",
    "    .groupby(\"stay_length_group\", observed=True)[\"target_cancelled\"]\n",
    "    .agg([\"count\", \"mean\"])\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "stay_analysis[\"cancellation_rate_%\"] = (\n",
    "    stay_analysis[\"mean\"] * 100\n",
    ")\n",
    "\n",
    "print(stay_analysis)\n",
    "\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "\n",
    "sns.barplot(\n",
    "    data=stay_analysis,\n",
    "    x=\"stay_length_group\",\n",
    "    y=\"cancellation_rate_%\"\n",
    ")\n",
    "\n",
    "plt.title(\"Cancellation Rate by Length of Stay\")\n",
    "plt.xlabel(\"Total Nights\")\n",
    "plt.ylabel(\"Cancellation Rate (%)\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. CANCELLATION RATE BY ESTIMATED BOOKING VALUE\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"11. CANCELLATION RATE BY ESTIMATED BOOKING VALUE\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "# Create value groups based on quartiles.\n",
    "# This avoids choosing arbitrary monetary thresholds.\n",
    "df_clean[\"booking_value_group\"] = pd.qcut(\n",
    "    df_clean[\"estimated_booking_value\"],\n",
    "    q=4,\n",
    "    duplicates=\"drop\"\n",
    ")\n",
    "\n",
    "booking_value_analysis = (\n",
    "    df_clean\n",
    "    .groupby(\"booking_value_group\", observed=True)[\"target_cancelled\"]\n",
    "    .agg([\"count\", \"mean\"])\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "booking_value_analysis[\"cancellation_rate_%\"] = (\n",
    "    booking_value_analysis[\"mean\"] * 100\n",
    ")\n",
    "\n",
    "print(booking_value_analysis)\n",
    "\n",
    "\n",
    "plt.figure(figsize=(11, 5))\n",
    "\n",
    "sns.barplot(\n",
    "    data=booking_value_analysis,\n",
    "    x=\"booking_value_group\",\n",
    "    y=\"cancellation_rate_%\"\n",
    ")\n",
    "\n",
    "plt.title(\"Cancellation Rate by Estimated Booking Value\")\n",
    "plt.xlabel(\"Estimated Booking Value Quartile\")\n",
    "plt.ylabel(\"Cancellation Rate (%)\")\n",
    "\n",
    "plt.xticks(rotation=30)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. CANCELLATION RATE BY MEAL PLAN\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"12. CANCELLATION RATE BY MEAL PLAN\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "meal_analysis = (\n",
    "    df_clean\n",
    "    .groupby(\"type_of_meal_plan\")[\"target_cancelled\"]\n",
    "    .agg([\"count\", \"mean\"])\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "meal_analysis[\"cancellation_rate_%\"] = (\n",
    "    meal_analysis[\"mean\"] * 100\n",
    ")\n",
    "\n",
    "meal_analysis = meal_analysis.sort_values(\n",
    "    \"cancellation_rate_%\",\n",
    "    ascending=False\n",
    ")\n",
    "\n",
    "print(meal_analysis)\n",
    "\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "\n",
    "sns.barplot(\n",
    "    data=meal_analysis,\n",
    "    x=\"type_of_meal_plan\",\n",
    "    y=\"cancellation_rate_%\"\n",
    ")\n",
    "\n",
    "plt.title(\"Cancellation Rate by Meal Plan\")\n",
    "plt.xlabel(\"Meal Plan\")\n",
    "plt.ylabel(\"Cancellation Rate (%)\")\n",
    "\n",
    "plt.xticks(rotation=30)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. CORRELATION HEATMAP\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"13. NUMERICAL FEATURE CORRELATION\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "# Select numerical variables that are useful for analysis.\n",
    "correlation_features = [\n",
    "    \"no_of_adults\",\n",
    "    \"no_of_children\",\n",
    "    \"no_of_weekend_nights\",\n",
    "    \"no_of_week_nights\",\n",
    "    \"total_nights\",\n",
    "    \"total_guests\",\n",
    "    \"lead_time\",\n",
    "    \"no_of_previous_cancellations\",\n",
    "    \"no_of_previous_bookings_not_canceled\",\n",
    "    \"total_previous_bookings\",\n",
    "    \"previous_cancellation_rate\",\n",
    "    \"avg_price_per_room\",\n",
    "    \"estimated_booking_value\",\n",
    "    \"no_of_special_requests\",\n",
    "    \"repeated_guest\",\n",
    "    \"required_car_parking_space\",\n",
    "    \"target_cancelled\"\n",
    "]\n",
    "\n",
    "# Calculate correlations.\n",
    "correlation_matrix = df_clean[\n",
    "    correlation_features\n",
    "].corr()\n",
    "\n",
    "# Print correlation with our target only.\n",
    "target_correlations = (\n",
    "    correlation_matrix[\"target_cancelled\"]\n",
    "    .sort_values(\n",
    "        ascending=False\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\"\\nCorrelation with cancellation target:\")\n",
    "print(target_correlations)\n",
    "\n",
    "\n",
    "# Create heatmap.\n",
    "plt.figure(figsize=(14, 11))\n",
    "\n",
    "sns.heatmap(\n",
    "    correlation_matrix,\n",
    "    annot=True,\n",
    "    fmt=\".2f\",\n",
    "    cmap=\"coolwarm\",\n",
    "    center=0\n",
    ")\n",
    "\n",
    "plt.title(\"Correlation Matrix of Numerical Features\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. TOP NUMERICAL FEATURES ASSOCIATED WITH CANCELLATION\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"14. NUMERICAL FEATURES MOST ASSOCIATED WITH CANCELLATION\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "# Remove the target itself.\n",
    "feature_target_correlations = (\n",
    "    target_correlations\n",
    "    .drop(\"target_cancelled\")\n",
    ")\n",
    "\n",
    "# Sort by absolute correlation strength.\n",
    "top_correlations = (\n",
    "    feature_target_correlations\n",
    "    .abs()\n",
    "    .sort_values(ascending=False)\n",
    ")\n",
    "\n",
    "print(\n",
    "    top_correlations.head(10)\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. EDA SUMMARY TABLE\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"15. EDA SUMMARY\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "eda_summary = pd.DataFrame({\n",
    "\n",
    "    \"Analysis\": [\n",
    "        \"Overall cancellation rate\",\n",
    "        \"Highest cancellation-rate market segment\",\n",
    "        \"Lowest cancellation-rate market segment\",\n",
    "        \"Highest cancellation-rate room type\",\n",
    "        \"Lowest cancellation-rate room type\",\n",
    "        \"Highest cancellation-rate arrival month\",\n",
    "        \"Highest cancellation-rate arrival weekday\",\n",
    "        \"Highest cancellation-rate stay-length group\"\n",
    "    ],\n",
    "\n",
    "    \"Result\": [\n",
    "\n",
    "        f\"{df_clean['target_cancelled'].mean() * 100:.2f}%\",\n",
    "\n",
    "        market_analysis.loc[\n",
    "            market_analysis[\"cancellation_rate_%\"].idxmax(),\n",
    "            \"market_segment_type\"\n",
    "        ],\n",
    "\n",
    "        market_analysis.loc[\n",
    "            market_analysis[\"cancellation_rate_%\"].idxmin(),\n",
    "            \"market_segment_type\"\n",
    "        ],\n",
    "\n",
    "        room_analysis.loc[\n",
    "            room_analysis[\"cancellation_rate_%\"].idxmax(),\n",
    "            \"room_type_reserved\"\n",
    "        ],\n",
    "\n",
    "        room_analysis.loc[\n",
    "            room_analysis[\"cancellation_rate_%\"].idxmin(),\n",
    "            \"room_type_reserved\"\n",
    "        ],\n",
    "\n",
    "        int(\n",
    "            month_analysis.loc[\n",
    "                month_analysis[\"cancellation_rate_%\"].idxmax(),\n",
    "                \"arrival_month\"\n",
    "            ]\n",
    "        ),\n",
    "\n",
    "        weekday_analysis.loc[\n",
    "            weekday_analysis[\"cancellation_rate_%\"].idxmax(),\n",
    "            \"arrival_day_of_week\"\n",
    "        ],\n",
    "\n",
    "        stay_analysis.loc[\n",
    "            stay_analysis[\"cancellation_rate_%\"].idxmax(),\n",
    "            \"stay_length_group\"\n",
    "        ]\n",
    "    ]\n",
    "})\n",
    "\n",
    "print(eda_summary.to_string(index=False))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. SAVE EDA RESULTS\n",
    "# ============================================================\n",
    "\n",
    "# Save important analysis tables so that we can use them\n",
    "# later when preparing the paper.\n",
    "\n",
    "lead_time_analysis.to_csv(\n",
    "    \"eda_lead_time_analysis.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "market_analysis.to_csv(\n",
    "    \"eda_market_segment_analysis.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "room_analysis.to_csv(\n",
    "    \"eda_room_type_analysis.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "month_analysis.to_csv(\n",
    "    \"eda_month_analysis.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "weekday_analysis.to_csv(\n",
    "    \"eda_weekday_analysis.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "guest_type_analysis.to_csv(\n",
    "    \"eda_guest_type_analysis.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "previous_cancel_analysis.to_csv(\n",
    "    \"eda_previous_cancellation_analysis.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "stay_analysis.to_csv(\n",
    "    \"eda_stay_length_analysis.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "booking_value_analysis.to_csv(\n",
    "    \"eda_booking_value_analysis.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "meal_analysis.to_csv(\n",
    "    \"eda_meal_plan_analysis.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "target_correlations.to_csv(\n",
    "    \"eda_target_correlations.csv\"\n",
    ")\n",
    "\n",
    "print(\"\\nEDA analysis tables saved successfully.\")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. FINAL MESSAGE\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"STEP 4 COMPLETED SUCCESSFULLY\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\"\"\"\n",
    "We have now explored the major relationships between\n",
    "hotel booking characteristics and cancellation.\n",
    "\n",
    "Next step:\n",
    "STEP 5 - Define the final ML feature set and create\n",
    "a strict chronological Train / Validation / Calibration /\n",
    "Test split.\n",
    "\n",
    "IMPORTANT:\n",
    "Do NOT train any ML model yet.\n",
    "\"\"\")"
   ]
  },
