    "# ================================================================\n",
    "# STEP 15 — PROBABILITY DRIFT + HYBRID POLICY DIAGNOSTICS\n",
    "# ================================================================\n",
    "# Purpose:\n",
    "#   Understand why the historical baseline is outperforming the\n",
    "#   ML-based probability policies.\n",
    "#\n",
    "# We compare:\n",
    "#   1. Historical cancellation probability\n",
    "#   2. Raw ML cancellation probability\n",
    "#   3. Calibrated ML cancellation probability\n",
    "#\n",
    "# against the actual TEST cancellation rate.\n",
    "#\n",
    "# We also construct diagnostic probability blends:\n",
    "#\n",
    "#   p_hybrid = alpha * p_calibrated\n",
    "#             + (1-alpha) * p_historical\n",
    "#\n",
    "# These blends are NOT yet selected as the final model.\n",
    "# They are diagnostic candidates for the next stage.\n",
    "# ================================================================\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"STEP 15 — PROBABILITY DRIFT + HYBRID DIAGNOSTICS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 1. PREPARE TEST PROBABILITY DATA\n",
    "# ------------------------------------------------\n",
    "diagnostic_df = overbooking_test.copy()\n",
    "\n",
    "# Exclude zero-night bookings because they do not consume\n",
    "# room inventory in the overbooking simulation.\n",
    "diagnostic_df = diagnostic_df[\n",
    "    diagnostic_df[\"total_nights\"] > 0\n",
    "].copy()\n",
    "\n",
    "diagnostic_df[\"arrival_date_full\"] = pd.to_datetime(\n",
    "    diagnostic_df[\"arrival_date_full\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "diagnostic_df[\"estimated_booking_date\"] = pd.to_datetime(\n",
    "    diagnostic_df[\"estimated_booking_date\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "# Actual cancellation indicator\n",
    "diagnostic_df[\"actual_cancelled\"] = (\n",
    "    diagnostic_df[\"target_cancelled\"]\n",
    ")\n",
    "\n",
    "# Historical baseline from training data\n",
    "historical_cancel_probability = (\n",
    "    train_df[\"target_cancelled\"].mean()\n",
    ")\n",
    "\n",
    "# Booking-level model probabilities\n",
    "diagnostic_df[\"raw_cancel_probability\"] = (\n",
    "    diagnostic_df[\"raw_cancel_prob\"]\n",
    ")\n",
    "\n",
    "diagnostic_df[\"calibrated_cancel_probability\"] = (\n",
    "    diagnostic_df[\"calibrated_cancel_prob\"]\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 2. OVERALL PROBABILITY DRIFT\n",
    "# ------------------------------------------------\n",
    "actual_test_cancel_rate = (\n",
    "    diagnostic_df[\"actual_cancelled\"].mean()\n",
    ")\n",
    "\n",
    "raw_mean = (\n",
    "    diagnostic_df[\"raw_cancel_probability\"].mean()\n",
    ")\n",
    "\n",
    "calibrated_mean = (\n",
    "    diagnostic_df[\"calibrated_cancel_probability\"].mean()\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"OVERALL CANCELLATION PROBABILITY COMPARISON\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "overall_comparison = pd.DataFrame({\n",
    "    \"approach\": [\n",
    "        \"Historical Training Rate\",\n",
    "        \"Raw ML\",\n",
    "        \"Calibrated ML\",\n",
    "        \"Actual Test\"\n",
    "    ],\n",
    "    \"cancellation_probability\": [\n",
    "        historical_cancel_probability,\n",
    "        raw_mean,\n",
    "        calibrated_mean,\n",
    "        actual_test_cancel_rate\n",
    "    ]\n",
    "})\n",
    "\n",
    "overall_comparison[\"bias_vs_actual_test\"] = (\n",
    "    overall_comparison[\"cancellation_probability\"]\n",
    "    -\n",
    "    actual_test_cancel_rate\n",
    ")\n",
    "\n",
    "print(\n",
    "    overall_comparison.round(4).to_string(index=False)\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 3. ABSOLUTE FORECAST BIAS\n",
    "# ------------------------------------------------\n",
    "historical_bias = (\n",
    "    historical_cancel_probability\n",
    "    -\n",
    "    actual_test_cancel_rate\n",
    ")\n",
    "\n",
    "raw_bias = (\n",
    "    raw_mean\n",
    "    -\n",
    "    actual_test_cancel_rate\n",
    ")\n",
    "\n",
    "calibrated_bias = (\n",
    "    calibrated_mean\n",
    "    -\n",
    "    actual_test_cancel_rate\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"FORECAST BIAS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    f\"Historical baseline bias : {historical_bias:+.4f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Raw ML bias              : {raw_bias:+.4f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Calibrated ML bias       : {calibrated_bias:+.4f}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 4. DAILY FORECAST ACCURACY\n",
    "# ------------------------------------------------\n",
    "daily_drift = (\n",
    "    diagnostic_df\n",
    "    .groupby(\"arrival_date_full\")\n",
    "    .agg(\n",
    "        bookings=(\"actual_cancelled\", \"count\"),\n",
    "        actual_cancel_rate=(\"actual_cancelled\", \"mean\"),\n",
    "        raw_cancel_rate=(\"raw_cancel_probability\", \"mean\"),\n",
    "        calibrated_cancel_rate=(\n",
    "            \"calibrated_cancel_probability\",\n",
    "            \"mean\"\n",
    "        )\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "daily_drift[\"historical_cancel_rate\"] = (\n",
    "    historical_cancel_probability\n",
    ")\n",
    "\n",
    "daily_drift[\"historical_error\"] = (\n",
    "    daily_drift[\"historical_cancel_rate\"]\n",
    "    -\n",
    "    daily_drift[\"actual_cancel_rate\"]\n",
    ")\n",
    "\n",
    "daily_drift[\"raw_error\"] = (\n",
    "    daily_drift[\"raw_cancel_rate\"]\n",
    "    -\n",
    "    daily_drift[\"actual_cancel_rate\"]\n",
    ")\n",
    "\n",
    "daily_drift[\"calibrated_error\"] = (\n",
    "    daily_drift[\"calibrated_cancel_rate\"]\n",
    "    -\n",
    "    daily_drift[\"actual_cancel_rate\"]\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 5. DAILY ERROR SUMMARY\n",
    "# ------------------------------------------------\n",
    "daily_error_summary = pd.DataFrame({\n",
    "    \"approach\": [\n",
    "        \"Historical\",\n",
    "        \"Raw ML\",\n",
    "        \"Calibrated ML\"\n",
    "    ],\n",
    "    \"mean_absolute_daily_error\": [\n",
    "        daily_drift[\"historical_error\"].abs().mean(),\n",
    "        daily_drift[\"raw_error\"].abs().mean(),\n",
    "        daily_drift[\"calibrated_error\"].abs().mean()\n",
    "    ],\n",
    "    \"mean_daily_bias\": [\n",
    "        daily_drift[\"historical_error\"].mean(),\n",
    "        daily_drift[\"raw_error\"].mean(),\n",
    "        daily_drift[\"calibrated_error\"].mean()\n",
    "    ],\n",
    "    \"rmse_daily\": [\n",
    "        np.sqrt(\n",
    "            np.mean(\n",
    "                daily_drift[\"historical_error\"] ** 2\n",
    "            )\n",
    "        ),\n",
    "        np.sqrt(\n",
    "            np.mean(\n",
    "                daily_drift[\"raw_error\"] ** 2\n",
    "            )\n",
    "        ),\n",
    "        np.sqrt(\n",
    "            np.mean(\n",
    "                daily_drift[\"calibrated_error\"] ** 2\n",
    "            )\n",
    "        )\n",
    "    ]\n",
    "})\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"DAILY FORECAST ERROR\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    daily_error_summary.round(4).to_string(index=False)\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 6. CONSTRUCT HYBRID PROBABILITIES\n",
    "# ------------------------------------------------\n",
    "# Blend calibrated ML probability with the historical\n",
    "# training cancellation rate.\n",
    "#\n",
    "# alpha = 0:\n",
    "#     Pure historical baseline\n",
    "#\n",
    "# alpha = 1:\n",
    "#     Pure calibrated ML\n",
    "#\n",
    "# Intermediate values:\n",
    "#     Hybrid policy\n",
    "\n",
    "alpha_values = np.arange(\n",
    "    0.0,\n",
    "    1.01,\n",
    "    0.10\n",
    ")\n",
    "\n",
    "hybrid_rows = []\n",
    "\n",
    "for alpha in alpha_values:\n",
    "\n",
    "    hybrid_probability = (\n",
    "        alpha *\n",
    "        diagnostic_df[\n",
    "            \"calibrated_cancel_probability\"\n",
    "        ]\n",
    "        +\n",
    "        (1 - alpha) *\n",
    "        historical_cancel_probability\n",
    "    )\n",
    "\n",
    "    hybrid_mean = hybrid_probability.mean()\n",
    "\n",
    "    hybrid_bias = (\n",
    "        hybrid_mean -\n",
    "        actual_test_cancel_rate\n",
    "    )\n",
    "\n",
    "    hybrid_brier = np.mean(\n",
    "        (\n",
    "            hybrid_probability -\n",
    "            diagnostic_df[\"actual_cancelled\"]\n",
    "        ) ** 2\n",
    "    )\n",
    "\n",
    "    hybrid_rows.append({\n",
    "        \"alpha_ml\": alpha,\n",
    "        \"alpha_historical\": 1 - alpha,\n",
    "        \"mean_hybrid_cancel_probability\": hybrid_mean,\n",
    "        \"bias_vs_test\": hybrid_bias,\n",
    "        \"absolute_bias\": abs(hybrid_bias),\n",
    "        \"brier_score\": hybrid_brier\n",
    "    })\n",
    "\n",
    "\n",
    "hybrid_diagnostics = pd.DataFrame(\n",
    "    hybrid_rows\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 7. DISPLAY HYBRID DIAGNOSTICS\n",
    "# ------------------------------------------------\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"HYBRID PROBABILITY DIAGNOSTICS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    hybrid_diagnostics.round(4).to_string(index=False)\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 8. IDENTIFY SIMPLE DIAGNOSTIC BEST BLENDS\n",
    "# ------------------------------------------------\n",
    "best_bias_blend = (\n",
    "    hybrid_diagnostics\n",
    "    .sort_values(\"absolute_bias\")\n",
    "    .iloc[0]\n",
    ")\n",
    "\n",
    "best_brier_blend = (\n",
    "    hybrid_diagnostics\n",
    "    .sort_values(\"brier_score\")\n",
    "    .iloc[0]\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"DIAGNOSTIC BLEND RESULTS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    \"Closest-to-test-rate blend:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"  ML weight: {best_bias_blend['alpha_ml']:.1f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"  Historical weight: \"\n",
    "    f\"{best_bias_blend['alpha_historical']:.1f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"  Absolute bias: \"\n",
    "    f\"{best_bias_blend['absolute_bias']:.4f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nBest Brier-score blend on TEST \"\n",
    "    \"(DIAGNOSTIC ONLY — NOT FOR MODEL SELECTION):\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"  ML weight: {best_brier_blend['alpha_ml']:.1f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"  Historical weight: \"\n",
    "    f\"{best_brier_blend['alpha_historical']:.1f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"  Brier: \"\n",
    "    f\"{best_brier_blend['brier_score']:.4f}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 9. SAVE DIAGNOSTICS\n",
    "# ------------------------------------------------\n",
    "overall_comparison.to_csv(\n",
    "    \"probability_drift_overall.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "daily_drift.to_csv(\n",
    "    \"probability_drift_daily.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "daily_error_summary.to_csv(\n",
    "    \"probability_drift_daily_summary.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "hybrid_diagnostics.to_csv(\n",
    "    \"hybrid_probability_diagnostics.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"FILES SAVED\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\"probability_drift_overall.csv\")\n",
    "print(\"probability_drift_daily.csv\")\n",
    "print(\"probability_drift_daily_summary.csv\")\n",
    "print(\"hybrid_probability_diagnostics.csv\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"STEP 15 COMPLETE\")\n",
    "print(\"=\" * 70)"
   ]
