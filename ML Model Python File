    "# ================================================================\n",
    "# STEP 12 — CAPACITY SCENARIOS AND BASELINE ECONOMICS\n",
    "# ================================================================\n",
    "# Purpose:\n",
    "#   1. Estimate hotel capacity scenarios from TRAINING data only.\n",
    "#   2. Exclude zero-night bookings because they do not consume\n",
    "#      a room-night.\n",
    "#   3. Estimate baseline room revenue from training ADR.\n",
    "#   4. Define walking-cost scenarios as multiples of ADR.\n",
    "#\n",
    "# IMPORTANT:\n",
    "#   The test period is NOT used to estimate capacity or revenue.\n",
    "#   This preserves the integrity of the final business evaluation.\n",
    "# ================================================================\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"STEP 12 — CAPACITY SCENARIOS AND BASELINE ECONOMICS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 1. PREPARE TRAINING DATA FOR CAPACITY ESTIMATION\n",
    "# ------------------------------------------------\n",
    "capacity_df = train_df.copy()\n",
    "\n",
    "# Zero-night bookings do not consume a room-night.\n",
    "capacity_df = capacity_df[\n",
    "    capacity_df[\"total_nights\"] > 0\n",
    "].copy()\n",
    "\n",
    "# Proxy for actual show:\n",
    "# Not_Canceled is treated as a show.\n",
    "capacity_df[\"actual_show\"] = (\n",
    "    1 - capacity_df[\"target_cancelled\"]\n",
    ")\n",
    "\n",
    "print(\"\\nTraining rows used for capacity estimation:\",\n",
    "      len(capacity_df))\n",
    "\n",
    "print(\"Training date range:\",\n",
    "      capacity_df[\"arrival_date_full\"].min(),\n",
    "      \"to\",\n",
    "      capacity_df[\"arrival_date_full\"].max())\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 2. CALCULATE HISTORICAL DAILY SHOW-UPS\n",
    "# ------------------------------------------------\n",
    "daily_training = (\n",
    "    capacity_df\n",
    "    .groupby(\"arrival_date_full\")\n",
    "    .agg(\n",
    "        bookings=(\"Booking_ID\", \"count\"),\n",
    "        historical_shows=(\"actual_show\", \"sum\"),\n",
    "        cancellation_count=(\"target_cancelled\", \"sum\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "daily_training[\"historical_show_rate\"] = (\n",
    "    daily_training[\"historical_shows\"] /\n",
    "    daily_training[\"bookings\"]\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"HISTORICAL DAILY SHOW SUMMARY\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\n",
    "    daily_training[\n",
    "        [\n",
    "            \"bookings\",\n",
    "            \"historical_shows\",\n",
    "            \"cancellation_count\",\n",
    "            \"historical_show_rate\"\n",
    "        ]\n",
    "    ].describe().round(3)\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 3. ESTIMATE CAPACITY SCENARIOS\n",
    "# ------------------------------------------------\n",
    "# We use the distribution of historical daily show-ups.\n",
    "#\n",
    "# 25th percentile = conservative capacity\n",
    "# 50th percentile = base capacity\n",
    "# 75th percentile = high capacity\n",
    "#\n",
    "# Capacity must be an integer.\n",
    "\n",
    "capacity_quantiles = {\n",
    "    \"Conservative (25th percentile)\": 0.25,\n",
    "    \"Base (50th percentile)\": 0.50,\n",
    "    \"High (75th percentile)\": 0.75\n",
    "}\n",
    "\n",
    "capacity_scenarios = {}\n",
    "\n",
    "for scenario, q in capacity_quantiles.items():\n",
    "\n",
    "    capacity_value = int(\n",
    "        round(\n",
    "            daily_training[\"historical_shows\"].quantile(q)\n",
    "        )\n",
    "    )\n",
    "\n",
    "    capacity_scenarios[scenario] = capacity_value\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"CAPACITY SCENARIOS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "for scenario, capacity in capacity_scenarios.items():\n",
    "    print(f\"{scenario:35s}: {capacity} rooms\")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 4. TRAINING ADR\n",
    "# ------------------------------------------------\n",
    "# Use training-period average ADR as the baseline\n",
    "# single-night room revenue.\n",
    "#\n",
    "# This follows the team's stated single-night\n",
    "# treatment for the initial overbooking model.\n",
    "\n",
    "training_adr = capacity_df[\"avg_price_per_room\"].mean()\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"BASELINE ROOM ECONOMICS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(f\"Training-period mean ADR: {training_adr:.2f}\")\n",
    "\n",
    "\n",
    "# ------------------------------------------------\n",
    "# 5. WALKING-COST SCENARIOS\n",
    "# ------------------------------------------------\n",
    "# We will later stress-test the economic value of\n",
    "# overbooking under different costs of relocating\n",
    "# a guest.\n",
    "\n",
    "walk_cost_multipliers = [1, 2, 3]\n",
    "\n",
    "walk_cost_scenarios = {\n",
    "    f\"{multiplier}x ADR\": training_adr * multiplier\n",
    "    for multiplier in walk_cost_multipliers\n",
    "}\n",
    "\n",
    "for scenario, cost in walk_cost_scenarios.items():\n",
